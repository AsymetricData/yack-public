


fun take (s : string) : int = string_length (borrow s)
fun peek (s : borrow string) : int = string_length (s)

fun by_if (c : bool) : int =
    let
        val s = "hello" ^ "!"
        val b = borrow s
    in if c then take (s) else peek (b)
    end

fun by_case (n : int) : int =
    let
        val s = "bye" ^ "!"
        val b = borrow s
    in case n of
         0 => peek (b)
       | 1 => take (s)
       | _ => peek (b) + 1
    end



fun by_guard (n : int) : int =
    let
        val s = "guard" ^ "!"
        val b = borrow s
    in case n of
         0 if peek (b) > 10 => 0
       | _ => take (s)
    end

fun main () =
    let val total = by_if (true) + by_if (false) + by_case (0) + by_case (1) + by_case (2)
                    + by_guard (0) in
      print_int (total)
    end
