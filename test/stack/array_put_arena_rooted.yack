fun main () =
    let val values : string array = array_new ()
        val _ = array_push (values, "old")
        val kept =
            arena
                val text = "a" ^ "b"
                val _ = array_put_arena (values, 0, text)
            in values
            end
        val _ = arena
                    val junk = "ZZZZZZZZZZ" ^ "ZZZZZZZZZZ"
                    val _ = array_push (array_new (), junk)
                in ()
                end
        val value = array_get_borrow (kept, 0)
    in
        print_string (string_copy (value))
    end
