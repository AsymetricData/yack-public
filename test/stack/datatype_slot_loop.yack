



import yack/array

datatype box = Box of string

fun loop (values : box array, n : int) : int =
    if n <= 0 then 0
    else
        let val next = array.set (values, 0, Box (int_to_string (n)))
        in loop (next, n - 1)
        end

fun main () =
    let val values : box array = array.push (array.new (), Box ("start"))
    in print_int (loop (values, 1000000)) end
