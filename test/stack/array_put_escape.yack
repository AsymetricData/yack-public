fun main () =
    let val values : string array = array_new ()
        val _ = array_push (values, "old")
        val _ = arena
                    val text = "a" ^ "b"
                    val _ = array_put (values, 0, text)
                in ()
                end
        val _ = arena
                    val junk = "ZZZZZZZZZZ" ^ "ZZZZZZZZZZ"
                    val _ = array_push (array_new (), junk)
                in ()
                end
        val kept = array_get_borrow (values, 0)
    in
        print_string (string_copy (kept))
    end
