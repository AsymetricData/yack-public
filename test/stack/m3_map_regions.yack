fun make () : int map =
    let val values : int map = map_new ()
        val _ = map_set (values, "base", 7)
    in values end

fun grow (values : int map, count : int) : int map =
    if count = 0 then values
    else
        let val _ = map_set (values, "k" ^ int_to_string (count), count)
        in grow (values, count - 1) end

fun main () =
    let val values = grow (make (), 100)
    in print_int (map_get (values, "base") + map_length (values)) end
