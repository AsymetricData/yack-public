



fun loop (values : string array, n : int) : int =
    if n <= 0 then 0
    else
        let val _ = array_push (values, "")
            val _ = array_set (values, 0, "ab" ^ int_to_string (n))
            val _ = array_set
                      (values, 0,
                       "012345678901234567890123456789012345678901234567890123456789" ^
                       int_to_string (n) ^ "x")
        in loop (values, n - 1)
        end

fun main () =
    let val values : string array = array_new ()
    in print_int (loop (values, 3000)) end
