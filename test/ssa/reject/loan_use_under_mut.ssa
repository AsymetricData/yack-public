# expect: uses `s` (%0) while its mutable borrow `m` (%1) of `s` (%0) is live
# Reading the owner while a mutable borrow of it is still used after.
fun yack_f {
  b0(%0.s : string):
    %1.m : &mut string = borrow mut &%0.s
    %2.r : &string = borrow &%0.s
    %3 : int = string.string_length %2.r
    %4 : unit = call yack_touch %1.m
    drop %0.s : string
    return %3
}
