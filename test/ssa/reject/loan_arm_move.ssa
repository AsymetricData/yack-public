# expect: moves `s` (%3) while its borrow `b` (%4) of `s` (%3) is live
# The borrow is used in one arm and again after the move in the other.
fun yack_main {
  b0:
    %0 : bool = const true
    %1 : int = call yack_run %0!
    %2 : bool = const false
    %3 : int = call yack_run %2!
    %4 : int = + %1!, %3!
    %5 : unit = call print_int %4!
    return %5!
}
fun yack_run {
  b0(%0.c : bool):
    %1 : string = view const "a"
    %2 : string = view const "b"
    %3.s : string = concat move %1!, move %2!
    %4.b : &string = borrow &%3.s
    branch %0.c b1 b2
  b1:
    %6 : int = call yack_peek %4.b
    drop %3.s! : string
    jump b3(%6!)
  b2:
    %7 : int = call yack_take move %3.s!
    %8 : int = call yack_peek %4.b!
    jump b3(%7!)
  b3(%5.x : int):
    return %5.x!
}
fun yack_take {
  b0(%0.s : string):
    %1 : &string = borrow &%0.s
    %2 : int = string.string_length %1!
    drop %0.s! : string
    return %2!
}
fun yack_peek {
  b0(%0.s : &string):
    %1 : int = string.string_length %0.s!
    return %1!
}
