# expect: mutates `values` (%0) while its borrow `first` (%2) of `values` (%0) is live
# `map_remove` changes the map in place while a borrow of one of its
# values is still read after: the borrow may point to a freed entry.
fun yack_f {
  b0(%0.values : string map):
    %1 : string = view const "k"
    %2.first : &string = map.map_get_borrow %0.values, move %1
    %3 : string = view const "k"
    %4 : unit = map.map_remove %0.values, move %3
    %5 : int = string.string_length %2.first
    drop %0.values : string map
    return %5
}
