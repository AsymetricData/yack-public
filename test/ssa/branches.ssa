fun yack_pick {
  b0(%0.flag : bool, %1.left : string, %2.right : string):
    branch %0.flag b1 b2
  b1:
    %4 : &string = borrow &%2.right  # at 5:43
    %5 : int = string.string_length %4!  # at 5:43
    %7 : bool = test _ %5!  # at 5:43
    branch %7 b5 b6
  b2:
    drop %1.left! : string  # at 6:10
    jump b3(move %2.right!)
  b3(%3 : string):
    return move %3!
  b4(%6 : string):
    drop %2.right! : string  # at 5:13
    jump b3(move %6!)
  b5:
