fun yack_classify {
  b0(%0.n : int, %1.label : string):
    %3 : bool = test 0 %0.n  # at 9:10
    branch %3 b2 b3
  b1(%2 : int):
    drop %1.label! : string  # at 8:24
    return %2!
  b2:
    %4 : &string = borrow &%1.label  # at 10:36
