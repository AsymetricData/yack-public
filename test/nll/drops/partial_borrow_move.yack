import yack/string

type user : Affine = { name : string, tag : string }




fun take_name (user : user) : string =
    let val name = borrow user.name
        val size = string_length (name)
    in
        if size >= 0 then user.name else user.name
    end

fun main () : unit =
    let val user : user =
            { name = string_copy (borrow "name")
            , tag = string_copy (borrow "tag")
            }
        val name = take_name (user)
    in print_string (name)
    end
