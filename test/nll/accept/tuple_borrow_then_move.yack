import yack/string



fun tuple_then_move (line : string) : string =
    let val pair = (borrow line, 7)
        val size = string_length (pair.0)
    in
        if size >= 0 then line else line
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = tuple_then_move (s)
    in print_string (out)
    end
