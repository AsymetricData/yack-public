import yack/string



type user : Affine = { name : string }

fun steal (user : user) : string =
    let val borrowed = borrow user.name
        val stolen = user.name
    in stolen
    end

fun main () : unit =
    let val user : user = { name = string_copy (borrow "a") }
        val name = steal (user)
    in print_string (name)
    end
