import yack/string



fun identity (value : borrow string) : borrow string = value

fun use (line : string) : string =
    let val f = identity
        val borrowed = f (borrow line)
        val size = string_length (borrowed)
    in
        if size >= 0 then line else line
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = use (s)
    in print_string (out)
    end
