import yack/string



fun first_and_owner (line : string) : string =
    let val borrowed = borrow line
        val size = string_length (borrowed)
    in
        if size >= 0 then line else line
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = first_and_owner (s)
    in print_string (out)
    end
