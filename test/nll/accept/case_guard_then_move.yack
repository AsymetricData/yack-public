import yack/string



fun guarded (flag : bool, line : string) : string =
    let val borrowed = borrow line
        val result =
            case flag of
                true if string_length (borrowed) >= 0 =>
                    let val moved = line in moved end
              | _ => line
    in result
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = guarded (true, s)
    in print_string (out)
    end
