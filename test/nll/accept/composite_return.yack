import yack/string



fun both (line : borrow string) : (borrow string, int) = (line, 1)

fun use (line : string) : string =
    let val pair = both (borrow line)
        val size = string_length (pair.0)
    in
        if size >= 0 then line else line
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = use (s)
    in print_string (out)
    end
