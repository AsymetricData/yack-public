import yack/string



fun two_creations (line : string) : string =
    let val first = borrow line
        val n = string_length (first)
        val second = borrow line
        val m = string_length (second)
    in
        if n + m >= 0 then line else line
    end

fun main () : unit =
    let val s = string_copy (borrow "hello")
        val out = two_creations (s)
    in print_string (out)
    end
