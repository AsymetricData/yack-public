import yack/fs
import yack/process
import yack/string

fun run_once () : unit =
    case process.run
             (borrow "/bin/sh",
              Cons (("-c", Cons (("echo ok; exit 0", Nil))))) of
        Error (_) => ()
      | Ok (result) =>
            let val _ = string_length (borrow result.stdout)
                val _ = string_length (borrow result.stderr)
            in ()
            end

fun text_once () : unit =
    case process.run_with
             (borrow "/bin/cat", [],
              { input = process.Text ("payload"),
                output = process.Capture,
                errors = process.Capture }) of
        Error (_) => ()
      | Ok (result) =>
            let val _ = string_length (borrow result.stdout)
                val _ = string_length (borrow result.stderr)
            in ()
            end

fun fd_once () : unit =
    case process.run_with
             (borrow "/bin/true", [],
              { input = process.Inherit,
                output = process.To_fd (1),
                errors = process.To_fd (2) }) of
        Error (_) => ()
      | Ok (_) => ()

fun loop (remaining : int) : unit =
    if remaining <= 0 then ()
    else
        let val _ = run_once ()
            val _ = text_once ()
            val _ = fd_once ()
        in loop (remaining - 1)
        end

fun count_prefix (values : string list, prefix : borrow string) : int =
    case values of
        Nil => 0
      | Cons (name, rest) =>
            let val here = if string.starts_with (borrow name, prefix) then 1 else 0
            in here + count_prefix (rest, prefix)
            end

fun count_fds () : int =
    case fs.list_dir (borrow "/proc/self/fd") of
        Ok (entries) => list_length (entries)
      | Error (_) => -1

fun count_temps () : int =
    case fs.list_dir (borrow "/tmp") of
        Ok (entries) => count_prefix (entries, borrow "yack-process-")
      | Error (_) => -1

fun main () =
    let val fdsBefore = count_fds ()
        val tempsBefore = count_temps ()
        val _ = loop (50)
        val fdsAfter = count_fds ()
        val tempsAfter = count_temps ()
        val _ = print_int (fdsAfter - fdsBefore)
    in print_int (tempsAfter - tempsBefore)
    end
