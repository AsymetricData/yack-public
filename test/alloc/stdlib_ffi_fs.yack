import yack/fs

fun loop (remaining : int) : unit =
    if remaining <= 0 then ()
    else
        let val _ = fs.append_file (borrow "/tmp/yack-leak-fs/a.txt", borrow "x")
        in loop (remaining - 1)
        end

fun count_fds () : int =
    case fs.list_dir (borrow "/proc/self/fd") of
        Ok (entries) => list_length (entries)
      | Error (_) => -1

fun main () =
    let val _ = fs.remove (borrow "/tmp/yack-leak-fs/b.txt")
        val _ = fs.remove (borrow "/tmp/yack-leak-fs/a.txt")
        val _ = fs.remove (borrow "/tmp/yack-leak-fs/sub")
        val _ = fs.remove (borrow "/tmp/yack-leak-fs")
        val _ = fs.mkdir_all (borrow "/tmp/yack-leak-fs/sub")
        val _ = fs.append_file (borrow "/tmp/yack-leak-fs/a.txt", borrow "hello")
        val entries =
            case fs.list_dir (borrow "/tmp/yack-leak-fs") of
                Ok (values) => list_length (values)
              | Error (_) => -1
        val before = count_fds ()
        val _ = loop (200)
        val after = count_fds ()
        val _ = print_int (entries)
        val _ = print_int (after - before)
        val _ = fs.remove (borrow "/tmp/yack-leak-fs/a.txt")
        val _ = fs.remove (borrow "/tmp/yack-leak-fs/sub")
    in
        case fs.remove (borrow "/tmp/yack-leak-fs") of
            Ok (_) => ()
          | Error (_) => ()
    end
