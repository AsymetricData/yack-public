import alpage/Alpage
import alpage/Ctx
import alpage/Reply
import alpage/Request
import alpage/Response
import yack/io
import yack/os
import yack/string

fun home (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    Reply.ok (Response.text ("hello"))

fun sum (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    Reply.ok (Response.text ("{\"sum\":6}"))



fun echo (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    let val req = borrow request
        val body = Request.body (req)
    in Reply.ok (Response.text (body))
    end



fun echo_length (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    let val req = borrow request
        val body = Request.body (req)
        val size = string.length (borrow body)
    in Reply.ok (Response.text (int_to_string (size)))
    end

fun no_content (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    Reply.ok (Response.make (204, "text/plain; charset=utf-8", ""))



fun big (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    Reply.ok (Response.text (string.repeat (borrow "0123456789", 2000)))






fun grow_body (size : int, acc : string) : string =
    let val length = string.length (borrow acc)
    in
        if length >= size then acc
        else
            let val half = string.copy (borrow acc)
            in grow_body (size, acc ^ half)
            end
    end





fun huge (ctx : Ctx.t, request : consume Request.t) : Reply.t =
    Reply.ok (Response.text (grow_body (2621440, "0123456789")))

fun application () : Alpage.t =
    Alpage.new ()
    |> Alpage.get ("/", home)
    |> Alpage.get ("/big", big)
    |> Alpage.get ("/huge", huge)
    |> Alpage.post ("/sum", sum)
    |> Alpage.add ("HEAD", "/", home)
    |> Alpage.post ("/echo", echo)
    |> Alpage.post ("/echo-len", echo_length)
    |> Alpage.get ("/nocontent", no_content)



fun configured_port () : int =
    let val text = os.getenv_or ("YACK_HTTP_PORT", "18092")
    in
        case string_to_int (borrow text) of
            Some value => value
          | None => 18092
    end



fun reuse_port_enabled () : bool =
    let val text = os.getenv_or ("YACK_HTTP_REUSE_PORT", "0")
    in
        case string_to_int (borrow text) of
            Some value => value = 1
          | None => false
    end



fun env_int (name : string, fallback : int) : int =
    case os.getenv (name) of
        None => fallback
      | Some text =>
            (case string_to_int (borrow text) of
                 Some value => value
               | None => fallback)



fun apply_limits (settings : Alpage.config) : Alpage.config =
    let val connections =
            Alpage.max_connections
                (settings, env_int ("YACK_HTTP_MAX_CONNECTIONS", 1024))
        val requests =
            Alpage.max_request_bytes
                (connections, env_int ("YACK_HTTP_MAX_REQUEST_BYTES", 16384))
        val responses =
            Alpage.max_response_bytes
                (requests, env_int ("YACK_HTTP_MAX_RESPONSE_BYTES", 65536))
        val timeout =
            Alpage.request_timeout_ms
                ( responses
                , int_to_int64 (env_int ("YACK_HTTP_REQUEST_TIMEOUT_MS", 10000)))
    in timeout end

fun main () =
    let val base = Alpage.config (configured_port ())
        val shared =
            if reuse_port_enabled () then Alpage.reuse_port (base, true)
            else base
        val settings = apply_limits (shared)
    in
        case Alpage.run (application (), settings) of
            Ok _ => ()
          | Error message =>
                let val _ = io.print_line (borrow message)
                in os.exit (1)
                end
    end
