import net/Net
import yack/fs

fun resolve_loop (remaining : int) : unit =
    if remaining <= 0 then ()
    else
        let val count =
                case Net.resolve (borrow "localhost") of
                    Ok (values) => list_length (values)
                  | Error (_) => -1
            val _ = if count < 0 then -1 else 0
        in resolve_loop (remaining - 1)
        end

fun connect_loop (port : int, remaining : int) : unit =
    if remaining <= 0 then ()
    else
        case Net.connect (borrow "127.0.0.1", port) of
            Error (_) => ()
          | Ok (stream) =>
                let val _ = Net.close (stream)
                in connect_loop (port, remaining - 1)
                end

fun count_fds () : int =
    case fs.list_dir (borrow "/proc/self/fd") of
        Ok (entries) => list_length (entries)
      | Error (_) => -1

fun main () =
    case Net.listen (0) of
        Error (_) => print_int (-1)
      | Ok (listener) =>
            let val port = Net.local_port (borrow listener)
                val before = count_fds ()
                val _ = resolve_loop (50)
                val _ = connect_loop (port, 50)
                val after = count_fds ()
                val _ = Net.close_listener (listener)
            in print_int (after - before)
            end
