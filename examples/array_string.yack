fun main () =
  let val values : string array = array_new ()
      val _ = array_push (values, "hello")
      val _ = array_push (values, "wor" ^ "ld")
      val _ = array_set (values, 1, "yack")
      val first = array_get_borrow (values, 0)
      val second = array_get_borrow (values, 1)
  in print_int (string_length (first) + string_length (second))
  end
