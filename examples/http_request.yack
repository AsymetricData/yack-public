import yack/string
type header_span : Copy = { name_start : int, name_len : int, value_start : int, value_len : int }

fun skip_spaces (text : borrow string, index : int, length : int) : int =
    if index >= length then index
    else if string.char_at_unchecked (text, index) = 32 then
        skip_spaces (text, index + 1, length)
    else index

fun parse_header (line : borrow string) : header_span =
    let val length = string.length (line)
        val colon = string.index_of_char (line, 58)
        val valueStart = skip_spaces (line, colon + 1, length)
    in
        { name_start = 0
        , name_len = colon
        , value_start = valueStart
        , value_len = length - valueStart
        }
    end

fun main () =
    let val request = "Content-" ^ "Type: text/html; charset=utf-8"
        val header = parse_header (borrow request)
        val separator = " -> "
        val _name = print_span (borrow request, header.name_start, header.name_len)
        val _separator = print_span (borrow separator, 0, 4)
    in print_span (borrow request, header.value_start, header.value_len)
    end
