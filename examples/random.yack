import yack/array
import yack/random
import yack/string

fun main () =
    let val token = random.token_hex (8)
        val small = random.int_below (10)
        val raw = random.bytes (4)
        val tokenOk =
            case token of
                Ok (value) => string.length (borrow value) = 16
              | Error (_) => false
        val smallOk =
            case small of
                Ok (value) => if value >= 0 then value < 10 else false
              | Error (_) => false
        val rawOk =
            case raw of
                Ok (value) => array.length (borrow value) = 4
              | Error (_) => false
        val _ = print_int (if tokenOk then 1 else 0)
        val _ = print_int (if smallOk then 1 else 0)
    in print_int (if rawOk then 1 else 0)
    end
