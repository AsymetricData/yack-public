import net/Buffer
import net/Http
import net/Net
import yack/string

fun main () =
    case Net.listen (8080) of
        Error message => print_string (message)
      | Ok listener =>
          let val accepted = Net.accept (borrow listener)
          in case accepted of
               Error message =>
                   let val _ = Net.close_listener (listener)
                   in print_string (message)
                   end
             | Ok stream =>
                 let val epfd = sys.epoll_create ()
                     val added = Net.epoll_add_read (epfd, borrow stream)
                     val fds : int32 array = array_make (0, 4)
                     val events : int32 array = array_make (0, 4)
                     val ready = Net.epoll_wait (epfd, fds, events, 4, 1000)
                     val buffer = Buffer.buffer_new (4096)
                     val received = Buffer.buffer_recv (buffer, Net.stream_fd (borrow stream))
                     val requestBuffer = received.0
                     val requestText = Buffer.buffer_to_string (requestBuffer)
                     val request = Http.parse_request (requestText)
                     val response = Http.render_response ("hello")
                     val payload = bytes_from_string (borrow response)
                     val sent = send_from (Net.stream_fd (borrow stream), payload, 0, string.length (borrow response))
                     val _ = Net.close (stream)
                     val _ = Net.close_listener (listener)
                 in print_string ("served " ^ Http.target (request))
                 end
          end
