import yack/list

fun main () =
    let val values = Cons ((1, Cons ((2, Cons ((3, Nil))))))
        val doubled = list.map (x => x * 2, values)
        val kept = list.filter (x => x > 2, doubled)
        val total = list.foldl (pair =>
                          case pair of
                              (acc, x) => acc + x, 0, kept)
    in print_int (total)
    end
