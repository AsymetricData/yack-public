import yack/string
type http_header : Affine = { name : string, value : string }

fun skip_spaces (text : borrow string, index : int, length : int) : int =
    if index >= length then index
    else if string.char_at_unchecked (text, index) = 32 then
        skip_spaces (text, index + 1, length)
    else index

fun parse_header (line : borrow string) : http_header =
    let val length = string.length (line)
        val colon = string.index_of_char (line, 58)
        val valueStart = skip_spaces (line, colon + 1, length)
    in
        { name = string.slice (line, 0, colon)
        , value = string.slice (line, valueStart, length)
        }
    end

fun main () =
    let val line = "Content-Type: text/html; charset=utf-8"
        val header = parse_header (borrow line)
        val rendered = header.name ^ " -> " ^ header.value
    in print_string (rendered)
    end
