               , "scan.abort:"
               , "  call void @yack_abort_msg(ptr @.yack_msg_freelist_cycle)"
               , "  unreachable"
               , "scan.advance:"
               , "  %scan.next = load ptr, ptr %scan.cur, align 8"
               , "  %scan.hops.next = add i64 %scan.hops, 1"
               , "  %scan.toolong = icmp ugt i64 %scan.hops.next, 4096"
               , "  br i1 %scan.toolong, label %do.push, label %scan"
               , "do.push:"
               ]
             else [])
          @ [ "  %old = load ptr, ptr %headp, align 8"
            , "  store ptr %old, ptr %data, align 8"
            , "  store ptr %data, ptr %headp, align 8"
            , "  br label %done"
            ]
          @ [ "done:"
          , "  ret void"
          , "}"
          , ""
          , "define void @yack_free(ptr %p) {"
          , "entry:"
          , "  call void @yack_trace_free(ptr %p)"
          , "  ret void"
          , "}"
          , ""
          , "define ptr @yack_realloc(ptr %old, i64 %old_size, i64 %new_size) {"
          , "entry:"
          , "  %new = call ptr @yack_alloc(i64 %new_size)"
          , "  %shorter = icmp slt i64 %old_size, %new_size"
          , "  %n = select i1 %shorter, i64 %old_size, i64 %new_size"
          , "  %empty = icmp eq i64 %n, 0"
          , "  br i1 %empty, label %done, label %copy"
          , "copy:"
          , "  call void @memcpy(ptr %new, ptr %old, i64 %n)"
          , "  br label %done"
          , "done:"
          , "  call void @yack_trace_free(ptr %old)"
          , "  ret ptr %new"
          , "}"
          , ""
          ]
          @ asanRuntime poison
          @ traceScopeRuntime ()
          @ traceLogRuntime trace
          @ abortRuntime ()
          @ (if usesThreads then
               [ "declare ptr @malloc(i64) #2"
               , "declare void @free(ptr) #1"
               ] @ threadRuntime true
             else [])
    end
end
