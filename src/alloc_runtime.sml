structure AllocRuntime =
struct
  fun constantString text =
    let
      val escaped = String.translate
        (fn #"\n" => "\\0A"
          | #"\r" => "\\0D"
          | #"\t" => "\\09"
          | #"\"" => "\\22"
          | #"\\" => "\\5C"
          | ch =>
              if Char.ord ch >= 32 andalso Char.ord ch < 127 then
                Char.toString ch
              else
                let
                  val code = Char.ord ch
                  val hex = "0123456789ABCDEF"
                  fun digit n = String.sub (hex, n)
                in
                  "\\" ^ String.str (digit (code div 16)) ^
                  String.str (digit (code mod 16))
                end)
        text
    in
      "[" ^ Int.toString (String.size text + 1) ^ " x i8] c\"" ^
      escaped ^ "\\00\""
    end

  val directRegionAlloc =
    [ "define ptr @yack_region_alloc_direct(ptr %r, i64 %size) alwaysinline {"
    , "entry:"
    , "  %rounded0 = add i64 %size, 15"
    , "  %rounded = and i64 %rounded0, -16"
    , "  %p2 = getelementptr %yack.region, ptr %r, i32 0, i32 2"
    , "  %used = load i64, ptr %p2, align 8"
    , "  %need = add i64 %used, %rounded"
    , "  %p3 = getelementptr %yack.region, ptr %r, i32 0, i32 3"
    , "  %cap = load i64, ptr %p3, align 8"
    , "  %fits = icmp ule i64 %need, %cap"
    , "  br i1 %fits, label %bump, label %slow"
    , "bump:"
    , "  %p1 = getelementptr %yack.region, ptr %r, i32 0, i32 1"
    , "  %cur = load ptr, ptr %p1, align 8"
    , "  %ptr = getelementptr i8, ptr %cur, i64 %used"
    , "  store i64 %need, ptr %p2, align 8"
    , "  call void @yack_trace_alloc(ptr %ptr, i64 %rounded)"
    , "  ret ptr %ptr"
    , "slow:"
    , "  %out = call ptr @yack_region_alloc_slow_direct(ptr %r, i64 %rounded)"
    , "  ret ptr %out"
    , "}"
    , ""
    , "define ptr @yack_region_alloc_slow_direct(ptr %r, i64 %rounded) noinline {"
    , "entry:"
    , "  br label %grow"
    , "grow:"
    , "  %needblock = add i64 %rounded, 16"
    , "  %block = call ptr @yack_block_alloc(i64 %needblock)"
    , "  %p0 = getelementptr %yack.region, ptr %r, i32 0, i32 0"
    , "  %oldblocks = load ptr, ptr %p0, align 8"
    , "  store ptr %oldblocks, ptr %block, align 8"
    , "  store ptr %block, ptr %p0, align 8"
    , "  %data = getelementptr i8, ptr %block, i64 16"
    , "  %p1 = getelementptr %yack.region, ptr %r, i32 0, i32 1"
    , "  store ptr %data, ptr %p1, align 8"
    , "  %sizep = getelementptr i8, ptr %block, i64 8"
    , "  %blocksize = load i64, ptr %sizep, align 8"
    , "  %blockcap = sub i64 %blocksize, 16"
    , "  %p3 = getelementptr %yack.region, ptr %r, i32 0, i32 3"
    , "  store i64 %blockcap, ptr %p3, align 8"
    , "  %p2 = getelementptr %yack.region, ptr %r, i32 0, i32 2"
    , "  store i64 %rounded, ptr %p2, align 8"
    , "  call void @yack_trace_alloc(ptr %data, i64 %rounded)"
    , "  ret ptr %data"
    , "}"
    , ""
    ]

  fun fastRegionAlloc usesScratch =
    [ "define ptr @yack_region_alloc(ptr %r, i64 %size) alwaysinline {"
    , "entry:"
    , "  %rounded0 = add i64 %size, 15"
    , "  %rounded = and i64 %rounded0, -16"
    ]
    @ (if usesScratch then
         [ "  %all0 = load i8, ptr @yack_scratch_all, align 1"
         , "  %all = icmp ne i8 %all0, 0"
         , "  %notall = xor i1 %all, true"
         , "  %root0 = load i64, ptr @yack_store_root, align 8"
         , "  %isroot = icmp ne i64 %root0, 0"
         , "  %noscratch = or i1 %notall, %isroot"
         ]
       else [])
    @ [ "  %p2 = getelementptr %yack.region, ptr %r, i32 0, i32 2"
      , "  %used = load i64, ptr %p2, align 8"
      , "  %need = add i64 %used, %rounded"
      , "  %p3 = getelementptr %yack.region, ptr %r, i32 0, i32 3"
      , "  %cap = load i64, ptr %p3, align 8"
      , "  %fits = icmp ule i64 %need, %cap"
      ]
    @ (if usesScratch then
         [ "  %fast = and i1 %fits, %noscratch" ]
       else [ "  %fast = icmp ule i64 %need, %cap" ])
    @ [ "  br i1 %fast, label %bump, label %slow"
      , "bump:"
      , "  %p1 = getelementptr %yack.region, ptr %r, i32 0, i32 1"
      , "  %cur = load ptr, ptr %p1, align 8"
      , "  %ptr = getelementptr i8, ptr %cur, i64 %used"
      , "  store i64 %need, ptr %p2, align 8"
      , "  call void @yack_trace_alloc(ptr %ptr, i64 %rounded)"
      , "  ret ptr %ptr"
      , "slow:"
      , "  %out = call ptr @yack_region_alloc_slow(ptr %r, i64 %rounded)"
      , "  ret ptr %out"
      , "}"
      , ""
      ]

  fun slowRegionAlloc usesScratch =
    [ "define ptr @yack_region_alloc_slow(ptr %r, i64 %rounded) noinline {"
    , "entry:"
    ]
    @ (if usesScratch then
         [ "  %all0 = load i8, ptr @yack_scratch_all, align 1"
         , "  %all = icmp ne i8 %all0, 0"
         , "  %root0 = load i64, ptr @yack_store_root, align 8"
         , "  %isroot = icmp ne i64 %root0, 0"
         , "  %notroot = xor i1 %isroot, true"
         , "  %usescratch = and i1 %all, %notroot"
         , "  br i1 %usescratch, label %scratch, label %grow"
         , "scratch:"
         , "  %sp = call ptr @yack_scratch_alloc(i64 %rounded)"
         , "  call void @yack_trace_alloc(ptr %sp, i64 %rounded)"
         , "  ret ptr %sp"
         ]
       else [ "  br label %grow" ])
    @ [ "grow:"
      , "  %needblock = add i64 %rounded, 16"
      , "  %block = call ptr @yack_block_alloc(i64 %needblock)"
      , "  %p0 = getelementptr %yack.region, ptr %r, i32 0, i32 0"
      , "  %oldblocks = load ptr, ptr %p0, align 8"
      , "  store ptr %oldblocks, ptr %block, align 8"
      , "  store ptr %block, ptr %p0, align 8"
      , "  %data = getelementptr i8, ptr %block, i64 16"
      , "  %p1 = getelementptr %yack.region, ptr %r, i32 0, i32 1"
      , "  store ptr %data, ptr %p1, align 8"
      , "  %sizep = getelementptr i8, ptr %block, i64 8"
      , "  %blocksize = load i64, ptr %sizep, align 8"
      , "  %blockcap = sub i64 %blocksize, 16"
      , "  %p3 = getelementptr %yack.region, ptr %r, i32 0, i32 3"
      , "  store i64 %blockcap, ptr %p3, align 8"
      , "  %p2 = getelementptr %yack.region, ptr %r, i32 0, i32 2"
      , "  store i64 %rounded, ptr %p2, align 8"
      , "  call void @yack_trace_alloc(ptr %data, i64 %rounded)"
      , "  ret ptr %data"
      , "}"
      , ""
      ]

  fun asanRuntime poison =
    if not poison then []
    else
      [ "declare void @__asan_poison_memory_region(ptr, i64)"
      , "declare void @__asan_unpoison_memory_region(ptr, i64)"
      , ""
      ]

  fun poisonCall addr size =
    [ "  call void @__asan_poison_memory_region(ptr " ^ addr ^
      ", i64 " ^ size ^ ")" ]

  fun unpoisonCall addr size =
    [ "  call void @__asan_unpoison_memory_region(ptr " ^ addr ^
      ", i64 " ^ size ^ ")" ]

  fun stackScratchLeave (poison, strict, limitText, scratchName) =
    let
      val poisonPart =
        if poison then
          [ "  %cut = load i64, ptr @" ^ scratchName ^ "_used, align 8"
          , "  %base = load ptr, ptr @" ^ scratchName ^ "_base, align 8"
          , "  %nobase = icmp eq ptr %base, null"
          , "  %empty = icmp eq i64 %cut, %mark"
          , "  %skip = or i1 %nobase, %empty"
          , "  br i1 %skip, label %after.poison, label %poison"
          , "poison:"
          , "  %start = getelementptr i8, ptr %base, i64 %mark"
          , "  %len = sub i64 %cut, %mark"
          , "  call void @__asan_poison_memory_region(ptr %start, i64 %len)"
          , "  br label %after.poison"
          , "after.poison:"
          ]
        else
          [ "  %cut = load i64, ptr @" ^ scratchName ^ "_used, align 8" ]
      val release =
        if strict then
          [ "  %qover = icmp ugt i64 %cut, " ^ limitText
          , "  br i1 %qover, label %quarantine.abort, label %after.limit"
          , "quarantine.abort:"
          , "  call void @yack_abort_msg(ptr @.yack_msg_quarantine)"
          , "  unreachable"
          , "after.limit:"
          ]
        else
          [ "  store i64 %mark, ptr @" ^ scratchName ^ "_used, align 8"
          , "  br label %after.limit"
          , "after.limit:"
          ]
    in
      [ "define void @yack_scratch_leave() {"
      , "entry:"
      , "  %depth = load i64, ptr @" ^ scratchName ^ "_depth, align 8"
      , "  %nonempty = icmp ugt i64 %depth, 0"
      , "  br i1 %nonempty, label %unwind, label %underflow"
      , "underflow:"
      , "  call void @yack_abort_msg(ptr @.yack_msg_underflow)"
      , "  unreachable"
      , "unwind:"
      , "  %prev = sub i64 %depth, 1"
      , "  store i64 %prev, ptr @" ^ scratchName ^ "_depth, align 8"
      , "  %markp = getelementptr [64 x i64], ptr @" ^ scratchName ^
        "_marks, i64 0, i64 %prev"
      , "  %mark = load i64, ptr %markp, align 8"
      ]
      @ poisonPart @ release @
      [ "  %allp = getelementptr [64 x i8], ptr @" ^ scratchName ^
        "_all_marks, i64 0, i64 %prev"
      , "  %all = load i8, ptr %allp, align 1"
      , "  store i8 %all, ptr @yack_scratch_all, align 1"
      , "  %outer = icmp eq i64 %prev, 0"
      , "  %active = select i1 %outer, i8 0, i8 1"
      , "  store i8 %active, ptr @yack_scratch_active, align 1"
      , "  ret void"
      , "}"
      , ""
      ]
    end

  fun heapArenaRuntime (poison, strict, limitText) =
    let
      val unpoisonUse =
        if poison then unpoisonCall "%bump" "%rounded" else []
      val unpoisonGrow =
        if poison then unpoisonCall "%data" "%rounded" else []
      val poisonChunk =
        if poison then
          [ "  %chunkdatap = getelementptr i8, ptr %chunk, i64 16"
          , "  %chunkdatasz = sub i64 %chunksize, 16"
          ] @ poisonCall "%chunkdatap" "%chunkdatasz"
        else []
      val releaseChunk =
        if strict then
          [ "  %qprev = load i64, ptr @yack_arena_qbytes, align 8"
          , "  %qnext = add i64 %qprev, %chunksize"
          , "  store i64 %qnext, ptr @yack_arena_qbytes, align 8"
          , "  %qover = icmp ugt i64 %qnext, " ^ limitText
          , "  br i1 %qover, label %quarantine.abort, label %free.done"
          ]
        else
          [ "  %oldfree = load ptr, ptr @yack_arena_free, align 8"
          , "  store ptr %oldfree, ptr %chunk"
          , "  store ptr %chunk, ptr @yack_arena_free, align 8"
          , "  br label %free.done"
          ]
      val quarantineAbort =
        if strict then
          [ "quarantine.abort:"
          , "  call void @yack_abort_msg(ptr @.yack_msg_quarantine)"
          , "  unreachable"
          ]
        else []
      val quarantineGlobal =
        if strict then
          [ "@yack_arena_qbytes = thread_local global i64 0" ]
        else []
    in
    [ "@yack_arena_depth = thread_local global i64 0"
    , "@yack_store_root = thread_local global i64 0"
    , "@yack_arena_bump = thread_local global ptr null, align 8"
    , "@yack_arena_end = thread_local global ptr null, align 8"
    , "@yack_arena_head = thread_local global ptr null, align 8"
    , "@yack_arena_free = thread_local global ptr null, align 8"
    , "@yack_arena_marks = thread_local global [64 x { ptr, ptr, ptr }] zeroinitializer"
    ]
    @ quarantineGlobal @
    [ ""
    , "define ptr @yack_arena_alloc(i64 %size) {"
    , "entry:"
    , "  %rounded0 = add i64 %size, 15"
    , "  %rounded = and i64 %rounded0, -16"
    , "  %bump = load ptr, ptr @yack_arena_bump, align 8"
    , "  %end = load ptr, ptr @yack_arena_end, align 8"
    , "  %next = getelementptr i8, ptr %bump, i64 %rounded"
    , "  %fits = icmp ule ptr %next, %end"
    , "  br i1 %fits, label %use, label %grow"
    , "use:"
    , "  store ptr %next, ptr @yack_arena_bump, align 8"
    ]
    @ unpoisonUse @
    [ "  ret ptr %bump"
    , "grow:"
    , "  %raw = add i64 %rounded, 16"
    , "  %small = icmp ult i64 %raw, 65536"
    , "  %need = select i1 %small, i64 65536, i64 %raw"
    , "  %freehead = load ptr, ptr @yack_arena_free, align 8"
    , "  %hasfree = icmp ne ptr %freehead, null"
    , "  br i1 %hasfree, label %search, label %fresh"
    , "search:"
    , "  %cur = phi ptr [ %freehead, %grow ], [ %nextchunk, %skip ]"
    , "  %prev = phi ptr [ null, %grow ], [ %cur, %skip ]"
    , "  %fsizep = getelementptr i8, ptr %cur, i64 8"
    , "  %fsize = load i64, ptr %fsizep, align 8"
    , "  %big = icmp uge i64 %fsize, %need"
    , "  br i1 %big, label %take, label %skip"
    , "skip:"
    , "  %nextchunk = load ptr, ptr %cur, align 8"
    , "  %more = icmp ne ptr %nextchunk, null"
    , "  br i1 %more, label %search, label %fresh"
    , "take:"
    , "  %fnext = load ptr, ptr %cur, align 8"
    , "  %ishead = icmp eq ptr %prev, null"
    , "  br i1 %ishead, label %unlink.head, label %unlink.mid"
    , "unlink.head:"
    , "  store ptr %fnext, ptr @yack_arena_free, align 8"
    , "  br label %link"
    , "unlink.mid:"
    , "  store ptr %fnext, ptr %prev, align 8"
    , "  br label %link"
    , "fresh:"
    , "  %freshchunk = call ptr @malloc(i64 %need)"
    , "  %failed = icmp eq ptr %freshchunk, null"
    , "  br i1 %failed, label %abort, label %setfresh"
    , "setfresh:"
    , "  %freshsize = getelementptr i8, ptr %freshchunk, i64 8"
    , "  store i64 %need, ptr %freshsize"
    , "  br label %link"
    , "link:"
    , "  %chunk = phi ptr [ %cur, %unlink.head ], [ %cur, %unlink.mid ], [ %freshchunk, %setfresh ]"
    , "  %chunksize = phi i64 [ %fsize, %unlink.head ], [ %fsize, %unlink.mid ], [ %need, %setfresh ]"
    , "  %head = load ptr, ptr @yack_arena_head, align 8"
    , "  store ptr %head, ptr %chunk"
    , "  %sizep = getelementptr i8, ptr %chunk, i64 8"
    , "  store i64 %chunksize, ptr %sizep"
    , "  store ptr %chunk, ptr @yack_arena_head, align 8"
    , "  %data = getelementptr i8, ptr %chunk, i64 16"
    , "  %newbump = getelementptr i8, ptr %data, i64 %rounded"
    , "  store ptr %newbump, ptr @yack_arena_bump, align 8"
    , "  %newend = getelementptr i8, ptr %chunk, i64 %chunksize"
    , "  store ptr %newend, ptr @yack_arena_end, align 8"
    ]
    @ unpoisonGrow @
    [ "  ret ptr %data"
    , "abort:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_alloc)"
    , "  unreachable"
    , "}"
    , ""
    , "define i1 @yack_arena_owns(ptr %p) {"
    , "entry:"
    , "  %depth = load i64, ptr @yack_arena_depth, align 8"
    , "  br label %outer"
    , "outer:"
    , "  %i = phi i64 [ 0, %entry ], [ %inext, %nextdepth ]"
    , "  %done = icmp ugt i64 %i, %depth"
    , "  br i1 %done, label %no, label %pick"
    , "pick:"
    , "  %current = icmp eq i64 %i, %depth"
    , "  br i1 %current, label %cur, label %saved"
    , "cur:"
    , "  %headcur = load ptr, ptr @yack_arena_head, align 8"
    , "  br label %scan"
    , "saved:"
    , "  %markp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %i, i32 0"
    , "  %headsaved = load ptr, ptr %markp, align 8"
    , "  br label %scan"
    , "scan:"
    , "  %head = phi ptr [ %headcur, %cur ], [ %headsaved, %saved ]"
    , "  br label %chunkloop"
    , "chunkloop:"
    , "  %chunk = phi ptr [ %head, %scan ], [ %nextchunk, %continue ]"
    , "  %isnull = icmp eq ptr %chunk, null"
    , "  br i1 %isnull, label %nextdepth, label %check"
    , "check:"
    , "  %sizep = getelementptr i8, ptr %chunk, i64 8"
    , "  %size = load i64, ptr %sizep, align 8"
    , "  %chunkend = getelementptr i8, ptr %chunk, i64 %size"
    , "  %ge = icmp uge ptr %p, %chunk"
    , "  %lt = icmp ult ptr %p, %chunkend"
    , "  %inside = and i1 %ge, %lt"
    , "  br i1 %inside, label %yes, label %continue"
    , "continue:"
    , "  %nextchunk = load ptr, ptr %chunk, align 8"
    , "  br label %chunkloop"
    , "nextdepth:"
    , "  %inext = add i64 %i, 1"
    , "  br label %outer"
    , "yes:"
    , "  ret i1 true"
    , "no:"
    , "  br label %freescan"
    , "freescan:"
    , "  %freehead = load ptr, ptr @yack_arena_free, align 8"
    , "  br label %freeloop"
    , "freeloop:"
    , "  %fchunk = phi ptr [ %freehead, %freescan ], [ %fnext, %freecont ]"
    , "  %fisnull = icmp eq ptr %fchunk, null"
    , "  br i1 %fisnull, label %nofree, label %freecheck"
    , "freecheck:"
    , "  %fsizep = getelementptr i8, ptr %fchunk, i64 8"
    , "  %fsize = load i64, ptr %fsizep, align 8"
    , "  %fend = getelementptr i8, ptr %fchunk, i64 %fsize"
    , "  %fge = icmp uge ptr %p, %fchunk"
    , "  %flt = icmp ult ptr %p, %fend"
    , "  %finside = and i1 %fge, %flt"
    , "  br i1 %finside, label %yes, label %freecont"
    , "freecont:"
    , "  %fnext = load ptr, ptr %fchunk, align 8"
    , "  br label %freeloop"
    , "nofree:"
    , "  ret i1 false"
    , "}"
    , ""
    , "define void @yack_scratch_enter() {"
    , "entry:"
    , "  %depth = load i64, ptr @yack_arena_depth, align 8"
    , "  %bounded = icmp ult i64 %depth, 64"
    , "  br i1 %bounded, label %save, label %overflow"
    , "overflow:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_depth)"
    , "  unreachable"
    , "save:"
    , "  %markp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %depth, i32 0"
    , "  %head = load ptr, ptr @yack_arena_head, align 8"
    , "  store ptr %head, ptr %markp, align 8"
    , "  %bumpp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %depth, i32 1"
    , "  %bump = load ptr, ptr @yack_arena_bump, align 8"
    , "  store ptr %bump, ptr %bumpp, align 8"
    , "  %endp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %depth, i32 2"
    , "  %end = load ptr, ptr @yack_arena_end, align 8"
    , "  store ptr %end, ptr %endp, align 8"
    , "  store ptr null, ptr @yack_arena_head, align 8"
    , "  store ptr null, ptr @yack_arena_bump, align 8"
    , "  store ptr null, ptr @yack_arena_end, align 8"
    , "  %next = add i64 %depth, 1"
    , "  store i64 %next, ptr @yack_arena_depth, align 8"
    , "  ret void"
    , "}"
    , ""
    , "define void @yack_scratch_enter_all() {"
    , "entry:"
    , "  call void @yack_scratch_enter()"
    , "  ret void"
    , "}"
    , ""
    , "define void @yack_scratch_leave() {"
    , "entry:"
    , "  %depth = load i64, ptr @yack_arena_depth, align 8"
    , "  %nonempty = icmp ugt i64 %depth, 0"
    , "  br i1 %nonempty, label %unwind, label %underflow"
    , "underflow:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_underflow)"
    , "  unreachable"
    , "unwind:"
    , "  %prev = sub i64 %depth, 1"
    , "  %head = load ptr, ptr @yack_arena_head, align 8"
    , "  br label %free.head"
    , "free.head:"
    , "  %chunk = phi ptr [ %head, %unwind ], [ %next, %free.done ]"
    , "  %isnull = icmp eq ptr %chunk, null"
    , "  br i1 %isnull, label %restore, label %free.chunk"
    , "free.chunk:"
    , "  %next = load ptr, ptr %chunk, align 8"
    , "  %sizep = getelementptr i8, ptr %chunk, i64 8"
    , "  %chunksize = load i64, ptr %sizep, align 8"
    ]
    @ poisonChunk @ releaseChunk @ quarantineAbort @
    [ "free.done:"
    , "  br label %free.head"
    , "restore:"
    , "  %markp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %prev, i32 0"
    , "  %savedhead = load ptr, ptr %markp, align 8"
    , "  store ptr %savedhead, ptr @yack_arena_head, align 8"
    , "  %bumpp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %prev, i32 1"
    , "  %savedbump = load ptr, ptr %bumpp, align 8"
    , "  store ptr %savedbump, ptr @yack_arena_bump, align 8"
    , "  %endp = getelementptr [64 x { ptr, ptr, ptr }], ptr @yack_arena_marks, i64 0, i64 %prev, i32 2"
    , "  %savedend = load ptr, ptr %endp, align 8"
    , "  store ptr %savedend, ptr @yack_arena_end, align 8"
    , "  store i64 %prev, ptr @yack_arena_depth, align 8"
    , "  ret void"
    , "}"
    , ""
    , "define { ptr, i64, i1 } @yack_string_root({ ptr, i64, i1 } %value) {"
    , "entry:"
    , "  %data = extractvalue { ptr, i64, i1 } %value, 0"
    , "  %len = extractvalue { ptr, i64, i1 } %value, 1"
    , "  %owned = call i1 @yack_arena_owns(ptr %data)"
    , "  br i1 %owned, label %copy, label %done"
    , "copy:"
    , "  %size = add i64 %len, 1"
    , "  %mem = call ptr @yack_root_alloc(i64 %size)"
    , "  call ptr @memcpy(ptr %mem, ptr %data, i64 %len)"
    , "  %strend = getelementptr i8, ptr %mem, i64 %len"
    , "  store i8 0, ptr %strend"
    , "  call void @yack_free(ptr %data)"
    , "  %v0 = insertvalue { ptr, i64, i1 } undef, ptr %mem, 0"
    , "  %v1 = insertvalue { ptr, i64, i1 } %v0, i64 %len, 1"
    , "  %v2 = insertvalue { ptr, i64, i1 } %v1, i1 true, 2"
    , "  ret { ptr, i64, i1 } %v2"
    , "done:"
    , "  ret { ptr, i64, i1 } %value"
    , "}"
    , ""
    , "define i1 @yack_ptr_in_arena(ptr %p) {"
    , "entry:"
    , "  %owned = call i1 @yack_arena_owns(ptr %p)"
    , "  ret i1 %owned"
    , "}"
    , ""
    ]
    end

  fun traceScopeRuntime () =
    [ "@yack_trace_site = thread_local global i64 0"
    , "@yack_trace_depth = thread_local global i64 0"
    , "@yack_trace_stack = thread_local global [64 x i64] zeroinitializer"
    , ""
    , "define void @yack_trace_enter(i64 %site) {"
    , "entry:"
    , "  %depth = load i64, ptr @yack_trace_depth, align 8"
    , "  %bounded = icmp ult i64 %depth, 64"
    , "  br i1 %bounded, label %save, label %overflow"
    , "overflow:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_depth)"
    , "  unreachable"
    , "save:"
    , "  %slot = getelementptr [64 x i64], ptr @yack_trace_stack, i64 0, i64 %depth"
    , "  store i64 %site, ptr %slot, align 8"
    , "  %next = add i64 %depth, 1"
    , "  store i64 %next, ptr @yack_trace_depth, align 8"
    , "  store i64 %site, ptr @yack_trace_site, align 8"
    , "  ret void"
    , "}"
    , ""
    , "define void @yack_trace_leave() {"
    , "entry:"
    , "  %depth = load i64, ptr @yack_trace_depth, align 8"
    , "  %nonempty = icmp ugt i64 %depth, 0"
    , "  br i1 %nonempty, label %unwind, label %underflow"
    , "underflow:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_underflow)"
    , "  unreachable"
    , "unwind:"
    , "  %prev = sub i64 %depth, 1"
    , "  store i64 %prev, ptr @yack_trace_depth, align 8"
    , "  %slot = getelementptr [64 x i64], ptr @yack_trace_stack, i64 0, i64 %prev"
    , "  %site = load i64, ptr %slot, align 8"
    , "  %outer = icmp eq i64 %prev, 0"
    , "  %restored = select i1 %outer, i64 0, i64 %site"
    , "  store i64 %restored, ptr @yack_trace_site, align 8"
    , "  ret void"
    , "}"
    , ""
    ]

  fun traceLogRuntime trace =
    [ "@yack_trace_on = global i8 " ^ (if trace then "1" else "0")
    , "@stderr = external global ptr"
    , "declare i32 @fprintf(ptr, ptr, ...) #1"
    , "@.trace_fmt_alloc = private unnamed_addr constant " ^
      constantString "[yack] alloc site=%llu ptr=%p size=%llu\n"
    , "@.trace_fmt_free = private unnamed_addr constant " ^
      constantString "[yack] free ptr=%p\n"
    , ""
    , "define void @yack_trace_alloc(ptr %p, i64 %size) {"
    , "entry:"
    , "  %on = load i8, ptr @yack_trace_on, align 1"
    , "  %enabled = icmp ne i8 %on, 0"
    , "  br i1 %enabled, label %log, label %done"
    , "log:"
    , "  %site = load i64, ptr @yack_trace_site, align 8"
    , "  %err = load ptr, ptr @stderr"
    , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.trace_fmt_alloc, i64 %site, ptr %p, i64 %size)"
    , "  br label %done"
    , "done:"
    , "  ret void"
    , "}"
    , ""
    , "define void @yack_trace_free(ptr %p) {"
    , "entry:"
    , "  %on = load i8, ptr @yack_trace_on, align 1"
    , "  %enabled = icmp ne i8 %on, 0"
    , "  br i1 %enabled, label %log, label %done"
    , "log:"
    , "  %err = load ptr, ptr @stderr"
