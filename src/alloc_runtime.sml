    , "  br label %done"
    , "done:"
    , "  ret void"
    , "}"
    , ""
    ]

  fun abortRuntime () =
    [ "@.yack_abort_fmt = private unnamed_addr constant " ^
      constantString "[yack] %s\n"
    , "@.yack_msg_depth = private unnamed_addr constant " ^
      constantString "scratch/arena nesting exceeds 64"
    , "@.yack_msg_underflow = private unnamed_addr constant " ^
      constantString "scratch/arena leave without a matching enter"
    , "@.yack_msg_scratch_overflow = private unnamed_addr constant " ^
      constantString "scratch arena exhausted"
    , "@.yack_msg_reserve_overflow = private unnamed_addr constant " ^
      constantString "stack reserve exhausted"
    , "@.yack_msg_mmap = private unnamed_addr constant " ^
      constantString "cannot reserve virtual memory"
    , "@.yack_msg_alloc = private unnamed_addr constant " ^
      constantString "allocation failed"
    , "@.yack_msg_oom = private unnamed_addr constant " ^
      constantString "out of memory"
    , "@.yack_msg_thread_create = private unnamed_addr constant " ^
      constantString "cannot create thread"
    , "@.yack_msg_thread_join = private unnamed_addr constant " ^
      constantString "cannot join thread"
    , "@.yack_msg_quarantine = private unnamed_addr constant " ^
      constantString "arena quarantine limit exceeded"
    , "@.yack_msg_div_zero = private unnamed_addr constant " ^
      constantString "division by zero"
    , "@.yack_msg_div_overflow = private unnamed_addr constant " ^
      constantString "division overflow"
    , "@.yack_msg_overflow = private unnamed_addr constant " ^
      constantString "integer overflow"
    , ""
    , "@.yack_bounds_fmt = private unnamed_addr constant " ^
      constantString "[yack] index %lld out of bounds (length %lld)\n"
    , ""
    , "define void @yack_abort_bounds(i64 %index, i64 %length) cold noreturn {"
    , "entry:"
    , "  %err = load ptr, ptr @stderr"
    , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.yack_bounds_fmt, i64 %index, i64 %length)"
    , "  call void @abort()"
    , "  unreachable"
    , "}"
    , ""
    , "@.yack_taken_fmt = private unnamed_addr constant " ^
      constantString "[yack] array element %lld was already taken\n"
    , ""
    , "define void @yack_abort_taken(i64 %index) cold noreturn {"
    , "entry:"
    , "  %err = load ptr, ptr @stderr"
    , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.yack_taken_fmt, i64 %index)"
    , "  call void @abort()"
    , "  unreachable"
    , "}"
    , ""
    , "define void @yack_abort_msg(ptr %msg) {"
    , "entry:"
    , "  %err = load ptr, ptr @stderr"
    , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.yack_abort_fmt, ptr %msg)"
    , "  call void @abort()"
    , "  unreachable"
    , "}"
    , ""

    , "declare ptr @signal(i32, ptr) #1"
    , "declare i32 @nanosleep(ptr, ptr) #1"
    , "@yack_stop_flag = global i32 0"
    , ""
    , "define void @yack_stop_handler(i32 %signo) {"
    , "entry:"
    , "  store volatile i32 1, ptr @yack_stop_flag"
    , "  ret void"
    , "}"
    , ""
    , "define void @yack_install_stop_signals() {"
    , "entry:"
    , "  store volatile i32 0, ptr @yack_stop_flag"
    , "  %interrupt = call ptr @signal(i32 2, ptr @yack_stop_handler)"
    , "  %terminate = call ptr @signal(i32 15, ptr @yack_stop_handler)"
    , "  ret void"
    , "}"
    , ""
    , "define i32 @yack_stop_requested() {"
    , "entry:"
    , "  %value = load volatile i32, ptr @yack_stop_flag"
    , "  ret i32 %value"
    , "}"
    , ""
    , "define void @yack_sleep_ms(i64 %ms) {"
    , "entry:"
    , "  %seconds = sdiv i64 %ms, 1000"
    , "  %remainder = srem i64 %ms, 1000"
    , "  %nanos = mul i64 %remainder, 1000000"
    , "  %request = alloca { i64, i64 }"
    , "  %secp = getelementptr { i64, i64 }, ptr %request, i32 0, i32 0"
    , "  store i64 %seconds, ptr %secp"
    , "  %nsecp = getelementptr { i64, i64 }, ptr %request, i32 0, i32 1"
    , "  store i64 %nanos, ptr %nsecp"
    , "  %r = call i32 @nanosleep(ptr %request, ptr null)"
    , "  ret void"
    , "}"
    , ""
    ]

  fun threadRuntime stackMode =
    let
      val callLines =
        if stackMode then
          [ "  %region = alloca %yack.region"
          , "  call void %fn(ptr %region, ptr @yack_root_region, i64 %arg)"
          ]
        else
          [ "  call void %fn(i64 %arg)" ]
    in
      [ "declare i32 @pthread_create(ptr, ptr, ptr, ptr) #1"
      , "declare i32 @pthread_join(i64, ptr) #1"
      , ""
      , "define ptr @yack_thread_entry(ptr %ctx) {"
      , "entry:"
      , "  %fn = load ptr, ptr %ctx, align 8"
      , "  %argp = getelementptr i8, ptr %ctx, i64 8"
      , "  %arg = load i64, ptr %argp, align 8"
      , "  call void @free(ptr %ctx)"
      ]
      @ callLines @
      [ "  ret ptr null"
      , "}"
      , ""
      , "define i64 @yack_thread_spawn(ptr %fn, i64 %arg) {"
      , "entry:"
      , "  %ctx = call ptr @malloc(i64 16)"
      , "  %ctxnull = icmp eq ptr %ctx, null"
      , "  br i1 %ctxnull, label %oom, label %store"
      , "oom:"
      , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
      , "  unreachable"
      , "store:"
      , "  store ptr %fn, ptr %ctx, align 8"
      , "  %argp = getelementptr i8, ptr %ctx, i64 8"
      , "  store i64 %arg, ptr %argp, align 8"
      , "  %tid = alloca i64"
      , "  %created = call i32 @pthread_create(ptr %tid, ptr null, ptr @yack_thread_entry, ptr %ctx)"
      , "  %failed = icmp ne i32 %created, 0"
      , "  br i1 %failed, label %create.failed, label %create.ok"
      , "create.failed:"
      , "  call void @free(ptr %ctx)"
      , "  call void @yack_abort_msg(ptr @.yack_msg_thread_create)"
      , "  unreachable"
      , "create.ok:"
      , "  %value = load i64, ptr %tid, align 8"
      , "  ret i64 %value"
      , "}"
      , ""
      , "define void @yack_thread_join(i64 %tid) {"
      , "entry:"
      , "  %joined = call i32 @pthread_join(i64 %tid, ptr null)"
      , "  %failed = icmp ne i32 %joined, 0"
      , "  br i1 %failed, label %join.failed, label %done"
      , "join.failed:"
      , "  call void @yack_abort_msg(ptr @.yack_msg_thread_join)"
      , "  unreachable"
      , "done:"
      , "  ret void"
      , "}"
      , ""
      ]
    end

  fun runtime
        (mode : Memory.mode, reserve : Int64.int, debugAlloc : bool,
         usesScratch : bool, usesThreads : bool, trace : bool) =
    let
      val reserveText = Int64.toString reserve
      val reservePlusPageText = Int64.toString (reserve + 4096)

      val scratchReserve =
        if reserve < 67108864 then reserve else 67108864
      val scratchReserveText = Int64.toString scratchReserve
      val scratchReservePlusPageText =
        Int64.toString (scratchReserve + 4096)
      val scratchName = "yack_scratch"
      val poison = Memory.poisonEnabled ()
      val strict = Memory.strictQuarantine ()
      val limitText = Int64.toString (!(Memory.arenaQuarantineLimit))
    in
      case mode of
        Memory.Heap =>
          if debugAlloc then
            [ "declare noalias ptr @malloc(i64) #2"
            , "declare void @free(ptr) #1"
            , "declare ptr @realloc(ptr, i64) #1"
            , "declare i32 @fprintf(ptr, ptr, ...) #1"
            , "@stderr = external global ptr"
            , "@yack_dbg_allocs = global i64 0"
            , "@yack_dbg_frees = global i64 0"
            , "@.fmt_alloc = private unnamed_addr constant " ^
              constantString "[yack] alloc site=%llu ptr=%p size=%llu\n"
            , "@.fmt_free = private unnamed_addr constant " ^
              constantString "[yack] free ptr=%p\n"
            , "@.fmt_realloc = private unnamed_addr constant " ^
              constantString "[yack] realloc %p -> %p size %llu\n"
            , "@.fmt_report = private unnamed_addr constant " ^
              constantString "[yack] allocs=%llu frees=%llu net=%lld\n"
            , ""
            , "define void @yack_dbg_alloc(ptr %p, i64 %size) {"
            , "entry:"
            , "  %a = load i64, ptr @yack_dbg_allocs"
            , "  %an = add i64 %a, 1"
            , "  store i64 %an, ptr @yack_dbg_allocs"
            , "  %err = load ptr, ptr @stderr"
            , "  %site = load i64, ptr @yack_trace_site, align 8"
            , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.fmt_alloc, i64 %site, ptr %p, i64 %size)"
            , "  ret void"
            , "}"
            , ""
            , "define void @yack_dbg_free(ptr %p) {"
            , "entry:"
            , "  %f = load i64, ptr @yack_dbg_frees"
            , "  %fn = add i64 %f, 1"
            , "  store i64 %fn, ptr @yack_dbg_frees"
            , "  %err = load ptr, ptr @stderr"
            , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.fmt_free, ptr %p)"
            , "  ret void"
            , "}"
            , ""
            , "define void @yack_dbg_realloc(ptr %old, ptr %new, i64 %size) {"
            , "entry:"
            , "  %f = load i64, ptr @yack_dbg_frees"
            , "  %fn = add i64 %f, 1"
            , "  store i64 %fn, ptr @yack_dbg_frees"
            , "  %a = load i64, ptr @yack_dbg_allocs"
            , "  %an = add i64 %a, 1"
            , "  store i64 %an, ptr @yack_dbg_allocs"
            , "  %err = load ptr, ptr @stderr"
            , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.fmt_realloc, ptr %old, ptr %new, i64 %size)"
            , "  ret void"
            , "}"
            , ""
            , "define void @yack_alloc_report() {"
            , "entry:"
            , "  %a = load i64, ptr @yack_dbg_allocs"
            , "  %f = load i64, ptr @yack_dbg_frees"
            , "  %net = sub i64 %a, %f"
            , "  %err = load ptr, ptr @stderr"
            , "  %r = call i32 (ptr, ptr, ...) @fprintf(ptr %err, ptr @.fmt_report, i64 %a, i64 %f, i64 %net)"
            , "  ret void"
            , "}"
            , ""
            , "define ptr @yack_alloc(i64 %size) {"
            , "entry:"
            , "  %p = call ptr @malloc(i64 %size)"
            , "  %isnull = icmp eq ptr %p, null"
            , "  %nonzero = icmp ne i64 %size, 0"
            , "  %failed = and i1 %isnull, %nonzero"
            , "  br i1 %failed, label %oom, label %ok"
            , "oom:"
            , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
            , "  unreachable"
            , "ok:"
            , "  call void @yack_dbg_alloc(ptr %p, i64 %size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_string_alloc(i64 %size) {"
            , "entry:"
            , "  %rounded0 = add i64 %size, 15"
            , "  %rounded = and i64 %rounded0, -16"
            , "  %forceroot = load i64, ptr @yack_store_root, align 8"
            , "  %force = icmp ne i64 %forceroot, 0"
            , "  br i1 %force, label %root, label %choose"
            , "choose:"
            , "  %depth = load i64, ptr @yack_arena_depth, align 8"
            , "  %active = icmp ne i64 %depth, 0"
            , "  br i1 %active, label %arena, label %root"
            , "arena:"
            , "  %ap = call ptr @yack_arena_alloc(i64 %rounded)"
            , "  call void @yack_dbg_alloc(ptr %ap, i64 %rounded)"
            , "  ret ptr %ap"
            , "root:"
            , "  %p = call ptr @malloc(i64 %rounded)"
            , "  %isnull = icmp eq ptr %p, null"
            , "  %nonzero = icmp ne i64 %rounded, 0"
            , "  %failed = and i1 %isnull, %nonzero"
            , "  br i1 %failed, label %oom, label %ok"
            , "oom:"
            , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
            , "  unreachable"
            , "ok:"
            , "  call void @yack_dbg_alloc(ptr %p, i64 %rounded)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_root_alloc(i64 %size) {"
            , "entry:"
            , "  %p = call ptr @yack_alloc(i64 %size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_root_realloc(ptr %old, i64 %old_size, i64 %new_size) {"
            , "entry:"
            , "  %p = call ptr @yack_realloc(ptr %old, i64 %old_size, i64 %new_size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define void @yack_free(ptr %p) {"
            , "entry:"
            , "  %inarena = call i1 @yack_arena_owns(ptr %p)"
            , "  br i1 %inarena, label %done, label %release"
            , "release:"
            , "  call void @free(ptr %p)"
            , "  br label %done"
            , "done:"
            , "  call void @yack_dbg_free(ptr %p)"
            , "  ret void"
            , "}"
            , ""
            , "define ptr @yack_realloc(ptr %old, i64 %old_size, i64 %new_size) {"
            , "entry:"
            , "  %inarena = call i1 @yack_arena_owns(ptr %old)"
            , "  br i1 %inarena, label %copy, label %system"
            , "system:"
            , "  %p = call ptr @realloc(ptr %old, i64 %new_size)"
            , "  %isnull = icmp eq ptr %p, null"
            , "  %nonzero = icmp ne i64 %new_size, 0"
            , "  %failed = and i1 %isnull, %nonzero"
            , "  br i1 %failed, label %oom, label %ok"
            , "oom:"
            , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
            , "  unreachable"
            , "ok:"
            , "  call void @yack_dbg_realloc(ptr %old, ptr %p, i64 %new_size)"
            , "  ret ptr %p"
            , "copy:"
            , "  call void @yack_dbg_free(ptr %old)"
            , "  %new = call ptr @yack_string_alloc(i64 %new_size)"
            , "  %shorter = icmp slt i64 %old_size, %new_size"
            , "  %n = select i1 %shorter, i64 %old_size, i64 %new_size"
            , "  %empty = icmp eq i64 %n, 0"
            , "  br i1 %empty, label %done, label %memcpy"
            , "memcpy:"
            , "  call ptr @memcpy(ptr %new, ptr %old, i64 %n)"
            , "  br label %done"
            , "done:"
            , "  ret ptr %new"
            , "}"
            , ""
            ]
            @ heapArenaRuntime (poison, strict, limitText)
            @ asanRuntime poison
            @ traceScopeRuntime ()
            @ abortRuntime ()
            @ (if usesThreads then threadRuntime false else [])
          else
            [ "declare noalias ptr @malloc(i64) #2"
            , "declare void @free(ptr) #1"
            , "declare ptr @realloc(ptr, i64) #1"
            , ""
            , "define ptr @yack_alloc(i64 %size) {"
            , "entry:"
            , "  %p = call ptr @malloc(i64 %size)"
            , "  %isnull = icmp eq ptr %p, null"
            , "  %nonzero = icmp ne i64 %size, 0"
            , "  %failed = and i1 %isnull, %nonzero"
            , "  br i1 %failed, label %oom, label %ok"
            , "oom:"
            , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
            , "  unreachable"
            , "ok:"
            , "  call void @yack_trace_alloc(ptr %p, i64 %size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_string_alloc(i64 %size) {"
            , "entry:"
            , "  %rounded0 = add i64 %size, 15"
            , "  %rounded = and i64 %rounded0, -16"
            , "  %forceroot = load i64, ptr @yack_store_root, align 8"
            , "  %force = icmp ne i64 %forceroot, 0"
            , "  br i1 %force, label %root, label %choose"
            , "choose:"
            , "  %depth = load i64, ptr @yack_arena_depth, align 8"
            , "  %active = icmp ne i64 %depth, 0"
            , "  br i1 %active, label %arena, label %root"
            , "arena:"
            , "  %ap = call ptr @yack_arena_alloc(i64 %rounded)"
            , "  call void @yack_trace_alloc(ptr %ap, i64 %rounded)"
            , "  ret ptr %ap"
            , "root:"
            , "  %p = call ptr @malloc(i64 %rounded)"
            , "  %isnull = icmp eq ptr %p, null"
            , "  %nonzero = icmp ne i64 %rounded, 0"
            , "  %failed = and i1 %isnull, %nonzero"
            , "  br i1 %failed, label %oom, label %ok"
            , "oom:"
            , "  call void @yack_abort_msg(ptr @.yack_msg_oom)"
            , "  unreachable"
            , "ok:"
            , "  call void @yack_trace_alloc(ptr %p, i64 %rounded)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_root_alloc(i64 %size) {"
            , "entry:"
            , "  %p = call ptr @yack_alloc(i64 %size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define ptr @yack_root_realloc(ptr %old, i64 %old_size, i64 %new_size) {"
            , "entry:"
            , "  %p = call ptr @yack_realloc(ptr %old, i64 %old_size, i64 %new_size)"
            , "  ret ptr %p"
            , "}"
            , ""
            , "define void @yack_free(ptr %p) {"
            , "entry:"
            , "  %depth = load i64, ptr @yack_arena_depth, align 8"
            , "  %active = icmp ne i64 %depth, 0"
            , "  %freehead = load ptr, ptr @yack_arena_free, align 8"
            , "  %hasfree = icmp ne ptr %freehead, null"
            , "  %maybe = or i1 %active, %hasfree"
