structure AllocRuntime =
struct
  fun constantString text =
    let
      val escaped = String.translate
        (fn #"\n" => "\\0A"
          | #"\r" => "\\0D"
          | #"\t" => "\\09"
          | #"\"" => "\\22"
          | #"\\" => "\\5C"
          | ch =>
              if Char.ord ch >= 32 andalso Char.ord ch < 127 then
                Char.toString ch
              else
                let
                  val code = Char.ord ch
                  val hex = "0123456789ABCDEF"
                  fun digit n = String.sub (hex, n)
                in
                  "\\" ^ String.str (digit (code div 16)) ^
                  String.str (digit (code mod 16))
                end)
        text
    in
      "[" ^ Int.toString (String.size text + 1) ^ " x i8] c\"" ^
      escaped ^ "\\00\""
    end

  fun asanRuntime poison =
    if not poison then []
    else
      [ "declare void @__asan_poison_memory_region(ptr, i64)"
      , "declare void @__asan_unpoison_memory_region(ptr, i64)"
      , ""
      ]

  fun poisonCall addr size =
    [ "  call void @__asan_poison_memory_region(ptr " ^ addr ^
      ", i64 " ^ size ^ ")" ]

  fun unpoisonCall addr size =
    [ "  call void @__asan_unpoison_memory_region(ptr " ^ addr ^
      ", i64 " ^ size ^ ")" ]

  fun regionAlloc poison direct usesScratch =
    let
      val name = if direct then "yack_region_alloc_direct" else "yack_region_alloc"
      val slowName = name ^ "_slow"
      val scratchGuard =
        if direct orelse not usesScratch then []
        else
          [ "  %all0 = load i8, ptr @yack_scratch_all, align 1"
          , "  %all = icmp ne i8 %all0, 0"
          , "  %notall = xor i1 %all, true"
          , "  %root0 = load i64, ptr @yack_store_root, align 8"
          , "  %isroot = icmp ne i64 %root0, 0"
          , "  %noscratch = or i1 %notall, %isroot"
          ]
      val fits =
        if direct orelse not usesScratch then
          [ "  %fast = icmp ule i64 %need, %cap" ]
        else
          [ "  %fits = icmp ule i64 %need, %cap"
          , "  %fast = and i1 %fits, %noscratch"
          ]
    in
      [ "define ptr @" ^ name ^ "(ptr %r, i64 %size) alwaysinline {"
      , "entry:"
      , "  %rounded0 = add i64 %size, 15"
      , "  %rounded = and i64 %rounded0, -16"
      ]
      @ scratchGuard
      @ [ "  %sp = getelementptr %yack.region, ptr %r, i32 0, i32 0"
        , "  %stack = load ptr, ptr %sp, align 8"
        , "  %ofp = getelementptr %yack.region, ptr %r, i32 0, i32 3"
        , "  %ofree = load ptr, ptr %ofp, align 8"
        , "  %hasowner = icmp ne ptr %ofree, null"
        ]
      @ (if direct orelse not usesScratch then
           [ "  %ownerok = icmp ne ptr %ofree, null" ]
         else
           [ "  %ownerok = and i1 %hasowner, %noscratch" ])
      @ [ "  br i1 %ownerok, label %owner.list, label %normal"
        , "owner.list:"
        , "  %owner.out = call ptr @yack_owner_alloc(ptr %r, i64 %rounded)"
        , "  ret ptr %owner.out"
        , "normal:"
        ]
      @ (if direct andalso poison then

           [ "  %omp = getelementptr %yack.region, ptr %r, i32 0, i32 1"
           , "  %omark = load i64, ptr %omp, align 8"
           , "  %oyp = getelementptr %yack.stack, ptr %stack, i32 0, i32 4"
           , "  %oyoung = load i64, ptr %oyp, align 8"
           , "  %ook = icmp eq i64 %oyoung, %omark"
           , "  br i1 %ook, label %owner.ok, label %owner.abort"
           , "owner.abort:"
           , "  call void @yack_abort_msg(ptr @.yack_msg_region_order)"
           , "  unreachable"
           , "owner.ok:"
           ]
         else [])
      @ [ "  %up = getelementptr %yack.stack, ptr %stack, i32 0, i32 1"
        , "  %used = load i64, ptr %up, align 8"
        , "  %need = add i64 %used, %rounded"
        , "  %cp = getelementptr %yack.stack, ptr %stack, i32 0, i32 2"
        , "  %cap = load i64, ptr %cp, align 8"
        ]
      @ fits
      @ [ "  br i1 %fast, label %bump, label %slow"
        , "bump:"
        , "  %bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
        , "  %base = load ptr, ptr %bp, align 8"
        , "  %ptr = getelementptr i8, ptr %base, i64 %used"
        ]
      @ (if poison then unpoisonCall "%ptr" "%rounded" else [])
      @ [ "  store i64 %need, ptr %up, align 8"
        , "  call void @yack_trace_alloc(ptr %ptr, i64 %rounded)"
        , "  ret ptr %ptr"
        , "slow:"
        , "  %out = call ptr @" ^ slowName ^ "(ptr %stack, i64 %rounded)"
        , "  ret ptr %out"
        , "}"
        , ""
        , "define ptr @" ^ slowName ^ "(ptr %stack, i64 %rounded) noinline {"
        , "entry:"
        ]
      @ (if direct orelse not usesScratch then
           [ "  br label %abort" ]
         else
           [ "  %all0 = load i8, ptr @yack_scratch_all, align 1"
           , "  %all = icmp ne i8 %all0, 0"
           , "  %root0 = load i64, ptr @yack_store_root, align 8"
           , "  %isroot = icmp ne i64 %root0, 0"
           , "  %notroot = xor i1 %isroot, true"
           , "  %usescratch = and i1 %all, %notroot"
           , "  br i1 %usescratch, label %scratch, label %abort"
           , "scratch:"
           , "  %sp = call ptr @yack_scratch_alloc(i64 %rounded)"
           , "  call void @yack_trace_alloc(ptr %sp, i64 %rounded)"
           , "  ret ptr %sp"
           ])
      @ [ "abort:"
        , "  call void @yack_abort_msg(ptr @.yack_msg_stack_overflow)"
        , "  unreachable"
        , "}"
        , ""
        ]
    end

  fun ownerRuntime poison =
    [ "define ptr @yack_owner_alloc(ptr %r, i64 %size) noinline {"
    , "entry:"
    , "  %rounded0 = add i64 %size, 15"
    , "  %rounded1 = and i64 %rounded0, -16"
    , "  %tiny = icmp ult i64 %rounded1, 16"
    , "  %rounded = select i1 %tiny, i64 16, i64 %rounded1"
    , "  %sp = getelementptr %yack.region, ptr %r, i32 0, i32 0"
    , "  %stack = load ptr, ptr %sp, align 8"
    , "  %isroot = icmp eq ptr %stack, @yack_root_stack"
    , "  br i1 %isroot, label %root, label %scan"
    , "root:"
    , "  %rooted = call ptr @yack_stack_alloc(ptr @yack_root_stack, i64 %rounded)"
    , "  ret ptr %rooted"
    , "scan:"
    ]
    @ (if poison then
         [ "  %omp = getelementptr %yack.region, ptr %r, i32 0, i32 1"
         , "  %omark = load i64, ptr %omp, align 8"
         , "  %oyp = getelementptr %yack.stack, ptr %stack, i32 0, i32 4"
         , "  %oyoung = load i64, ptr %oyp, align 8"
         , "  %ook = icmp eq i64 %oyoung, %omark"
         , "  br i1 %ook, label %owner.ok, label %owner.abort"
         , "owner.abort:"
         , "  call void @yack_abort_msg(ptr @.yack_msg_region_order)"
         , "  unreachable"
         ]
       else [ "  br label %owner.ok" ])
    @ [ "owner.ok:"
      , "  %headp = getelementptr %yack.region, ptr %r, i32 0, i32 3"
      , "  %head = load ptr, ptr %headp, align 8"
      , "  br label %loop"
    , "loop:"
    , "  %cur = phi ptr [ %head, %owner.ok ], [ %next, %continue ]"
    , "  %prev = phi ptr [ null, %owner.ok ], [ %cur, %continue ]"
    , "  %hops = phi i64 [ 0, %owner.ok ], [ %hops.next, %continue ]"
    , "  %isnull = icmp eq ptr %cur, null"
    , "  br i1 %isnull, label %bump, label %check"
    , "check:"
    , "  %sizep = getelementptr i8, ptr %cur, i64 8"
    , "  %cursize = load i64, ptr %sizep, align 8"
    , "  %fits = icmp eq i64 %cursize, %rounded"
    , "  br i1 %fits, label %take, label %continue"
    , "continue:"
    , "  %next = load ptr, ptr %cur, align 8"
    , "  %hops.next = add i64 %hops, 1"
    , "  %bounded = icmp uge i64 %hops.next, 64"
    , "  br i1 %bounded, label %bump, label %loop"
    , "take:"
    , "  %next2 = load ptr, ptr %cur, align 8"
    , "  %ishead = icmp eq ptr %prev, null"
    , "  br i1 %ishead, label %takehead, label %takemid"
    , "takehead:"
    , "  store ptr %next2, ptr %headp, align 8"
    , "  br label %taken"
    , "takemid:"
    , "  store ptr %next2, ptr %prev, align 8"
    , "  br label %taken"
    , "taken:"
    ]
    @ (if poison then unpoisonCall "%cur" "%rounded" else [])
    @ [

        "  %pop.bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
      , "  %pop.base = load ptr, ptr %pop.bp, align 8"
      , "  %pop.cur = ptrtoint ptr %cur to i64"
      , "  %pop.baseint = ptrtoint ptr %pop.base to i64"
      , "  %pop.rel = sub i64 %pop.cur, %pop.baseint"
      , "  %pop.end = add i64 %pop.rel, %cursize"
      , "  %pop.up = getelementptr %yack.stack, ptr %stack, i32 0, i32 1"
      , "  %pop.used = load i64, ptr %pop.up, align 8"
      , "  %pop.grew = icmp ugt i64 %pop.end, %pop.used"
      , "  %pop.newused = select i1 %pop.grew, i64 %pop.end, i64 %pop.used"
      , "  store i64 %pop.newused, ptr %pop.up, align 8"
      , "  ret ptr %cur"
      , "bump:"
      , "  %up = getelementptr %yack.stack, ptr %stack, i32 0, i32 1"
      , "  %used = load i64, ptr %up, align 8"
      , "  %need = add i64 %used, %rounded"
      , "  %cp = getelementptr %yack.stack, ptr %stack, i32 0, i32 2"
      , "  %cap = load i64, ptr %cp, align 8"
      , "  %overflow = icmp ugt i64 %need, %cap"
      , "  br i1 %overflow, label %abort, label %ok"
      , "abort:"
      , "  call void @yack_abort_msg(ptr @.yack_msg_stack_overflow)"
      , "  unreachable"
      , "ok:"
      , "  %bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
      , "  %base = load ptr, ptr %bp, align 8"
      , "  %ptr = getelementptr i8, ptr %base, i64 %used"
      ]
    @ (if poison then unpoisonCall "%ptr" "%rounded" else [])
    @ [ "  store i64 %need, ptr %up, align 8"
      , "  ret ptr %ptr"
      , "}"
      , ""
      , "define void @yack_owner_recycle_string(ptr %r, { ptr, i64, i1 } %value) {"
      , "entry:"
      , "  %owned = extractvalue { ptr, i64, i1 } %value, 2"
      , "  br i1 %owned, label %check, label %done"
      , "check:"
      , "  %data = extractvalue { ptr, i64, i1 } %value, 0"
      , "  %isnull = icmp eq ptr %data, null"
      , "  br i1 %isnull, label %done, label %range"
      , "range:"
      , "  %sp = getelementptr %yack.region, ptr %r, i32 0, i32 0"
      , "  %stack = load ptr, ptr %sp, align 8"
      , "  %isroot = icmp eq ptr %stack, @yack_root_stack"
      , "  br i1 %isroot, label %root, label %owner"
      , "root:"
      , "  call void @yack_root_recycle_string({ ptr, i64, i1 } %value)"
      , "  br label %done"
      , "owner:"
      , "  %markp = getelementptr %yack.region, ptr %r, i32 0, i32 1"
      , "  %mark = load i64, ptr %markp, align 8"
      , "  %bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
      , "  %base = load ptr, ptr %bp, align 8"
      , "  %low = getelementptr i8, ptr %base, i64 %mark"
      , "  %up = getelementptr %yack.stack, ptr %stack, i32 0, i32 1"
      , "  %used = load i64, ptr %up, align 8"
      , "  %high = getelementptr i8, ptr %base, i64 %used"
      , "  %ge = icmp uge ptr %data, %low"
      , "  %lt = icmp ult ptr %data, %high"
      , "  %inside = and i1 %ge, %lt"
      , "  br i1 %inside, label %push, label %elsewhere"
      , "elsewhere:"
      , "  call void @yack_root_recycle_string({ ptr, i64, i1 } %value)"
      , "  br label %done"
      , "push:"
      , "  %len = extractvalue { ptr, i64, i1 } %value, 1"
      , "  %size1 = add i64 %len, 1"
      , "  %small = icmp ult i64 %size1, 16"
      , "  %size0 = select i1 %small, i64 16, i64 %size1"
      , "  %size2 = add i64 %size0, 15"
      , "  %size = and i64 %size2, -16"
      , "  %freep = getelementptr %yack.region, ptr %r, i32 0, i32 3"
      , "  %old = load ptr, ptr %freep, align 8"
      , "  store ptr %old, ptr %data, align 8"
      , "  %sizep = getelementptr i8, ptr %data, i64 8"
      , "  store i64 %size, ptr %sizep, align 8"
      , "  store ptr %data, ptr %freep, align 8"
      , "  br label %done"
      , "done:"
      , "  ret void"
      , "}"
      , ""
      , "define void @yack_owner_recycle_block(ptr %r, ptr %block, i64 %size) {"
      , "entry:"
      , "  %r0 = add i64 %size, 15"
      , "  %rounded = and i64 %r0, -16"
      , "  %tiny = icmp ult i64 %rounded, 16"
      , "  %class.size = select i1 %tiny, i64 16, i64 %rounded"
      , "  %isnull = icmp eq ptr %block, null"
      , "  %empty = icmp eq i64 %size, 0"
      , "  %skip = or i1 %isnull, %empty"
      , "  br i1 %skip, label %done, label %range"
      , "range:"
      , "  %sp = getelementptr %yack.region, ptr %r, i32 0, i32 0"
      , "  %stack = load ptr, ptr %sp, align 8"
      , "  %isroot = icmp eq ptr %stack, @yack_root_stack"
      , "  br i1 %isroot, label %root, label %owner"
      , "root:"
      , "  %small = icmp ule i64 %class.size, 4096"
      , "  br i1 %small, label %root.push, label %done"
      , "root.push:"
      , "  %class = lshr i64 %class.size, 4"
      , "  %fp = getelementptr %yack.stack, ptr @yack_root_stack, i32 0, i32 3"
      , "  %heads = load ptr, ptr %fp, align 8"
      , "  %headp = getelementptr [257 x ptr], ptr %heads, i64 0, i64 %class"
      , "  %old = load ptr, ptr %headp, align 8"
      , "  store ptr %old, ptr %block, align 8"
      , "  %rsizep = getelementptr i8, ptr %block, i64 8"
      , "  store i64 %class.size, ptr %rsizep, align 8"
      , "  store ptr %block, ptr %headp, align 8"
      , "  br label %done"
      , "owner:"
      , "  %mp = getelementptr %yack.region, ptr %r, i32 0, i32 1"
      , "  %mark = load i64, ptr %mp, align 8"
      , "  %bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
      , "  %base = load ptr, ptr %bp, align 8"
      , "  %low = getelementptr i8, ptr %base, i64 %mark"
      , "  %up = getelementptr %yack.stack, ptr %stack, i32 0, i32 1"
      , "  %used = load i64, ptr %up, align 8"
      , "  %high = getelementptr i8, ptr %base, i64 %used"
      , "  %ge = icmp uge ptr %block, %low"
      , "  %lt = icmp ult ptr %block, %high"
      , "  %inside = and i1 %ge, %lt"
      , "  br i1 %inside, label %push, label %done"
      , "push:"
      , "  %freep = getelementptr %yack.region, ptr %r, i32 0, i32 3"
      , "  %old2 = load ptr, ptr %freep, align 8"
      , "  store ptr %old2, ptr %block, align 8"
      , "  %sizep = getelementptr i8, ptr %block, i64 8"
      , "  store i64 %class.size, ptr %sizep, align 8"
      , "  store ptr %block, ptr %freep, align 8"
      , "  br label %done"
      , "done:"
      , "  ret void"
      , "}"
      , ""
      ]

  fun stackReserve reserveText name =
    [ "define void @" ^ name ^ "(ptr %stack, i64 %bytes, ptr %heads) {"
    , "entry:"
    , "  %bp = getelementptr %yack.stack, ptr %stack, i32 0, i32 0"
    , "  %base = load ptr, ptr %bp, align 8"
    , "  %uninit = icmp eq ptr %base, null"
    , "  br i1 %uninit, label %init, label %ready"
    , "init:"
    , "  %total = add i64 %bytes, 4096"
    , "  %mapped = call ptr @mmap(ptr null, i64 %total, i32 3, i32 16418, i32 -1, i64 0)"
    , "  %failed = icmp eq ptr %mapped, inttoptr (i64 -1 to ptr)"
    , "  br i1 %failed, label %abort, label %guard"
    , "guard:"
    , "  %guardptr = getelementptr i8, ptr %mapped, i64 %bytes"
    , "  %protected = call i32 @mprotect(ptr %guardptr, i64 4096, i32 0)"
    , "  %bad = icmp ne i32 %protected, 0"
    , "  br i1 %bad, label %abort, label %save"
    , "save:"
    , "  store ptr %mapped, ptr %bp, align 8"
    , "  %cp = getelementptr %yack.stack, ptr %stack, i32 0, i32 2"
    , "  store i64 %bytes, ptr %cp, align 8"
    , "  %frp = getelementptr %yack.stack, ptr %stack, i32 0, i32 3"
    , "  store ptr %heads, ptr %frp, align 8"
    , "  %yp = getelementptr %yack.stack, ptr %stack, i32 0, i32 4"
    , "  store i64 0, ptr %yp, align 8"
    , "  br label %ready"
    , "ready:"
    , "  ret void"
    , "abort:"
    , "  call void @yack_abort_msg(ptr @.yack_msg_mmap)"
    , "  unreachable"
    , "}"
    , ""
    ]

  fun stackScratchLeave (poison, strict, limitText, scratchName) =
    let
      val poisonPart =
        if poison then
          [ "  %cut = load i64, ptr @" ^ scratchName ^ "_used, align 8"
          , "  %base = load ptr, ptr @" ^ scratchName ^ "_base, align 8"
          , "  %nobase = icmp eq ptr %base, null"
          , "  %empty = icmp eq i64 %cut, %mark"
          , "  %skip = or i1 %nobase, %empty"
          , "  br i1 %skip, label %after.poison, label %poison"
          , "poison:"
          , "  %start = getelementptr i8, ptr %base, i64 %mark"
          , "  %len = sub i64 %cut, %mark"
          , "  call void @__asan_poison_memory_region(ptr %start, i64 %len)"
          , "  br label %after.poison"
          , "after.poison:"
          ]
        else
          [ "  %cut = load i64, ptr @" ^ scratchName ^ "_used, align 8" ]
      val release =
        if strict then
          [ "  %qover = icmp ugt i64 %cut, " ^ limitText
          , "  br i1 %qover, label %quarantine.abort, label %after.limit"
          , "quarantine.abort:"
          , "  call void @yack_abort_msg(ptr @.yack_msg_quarantine)"
          , "  unreachable"
          , "after.limit:"
          ]
        else
          [ "  store i64 %mark, ptr @" ^ scratchName ^ "_used, align 8"
          , "  br label %after.limit"
          , "after.limit:"
          ]
    in
      [ "define void @yack_scratch_leave() {"
      , "entry:"
      , "  %depth = load i64, ptr @" ^ scratchName ^ "_depth, align 8"
      , "  %nonempty = icmp ugt i64 %depth, 0"
      , "  br i1 %nonempty, label %unwind, label %underflow"
      , "underflow:"
      , "  call void @yack_abort_msg(ptr @.yack_msg_underflow)"
      , "  unreachable"
      , "unwind:"
      , "  %prev = sub i64 %depth, 1"
      , "  store i64 %prev, ptr @" ^ scratchName ^ "_depth, align 8"
      , "  %markp = getelementptr [64 x i64], ptr @" ^ scratchName ^
        "_marks, i64 0, i64 %prev"
      , "  %mark = load i64, ptr %markp, align 8"
      ]
      @ poisonPart @ release @
      [ "  %allp = getelementptr [64 x i8], ptr @" ^ scratchName ^
        "_all_marks, i64 0, i64 %prev"
      , "  %all = load i8, ptr %allp, align 1"
      , "  store i8 %all, ptr @yack_scratch_all, align 1"
      , "  %outer = icmp eq i64 %prev, 0"
      , "  %active = select i1 %outer, i8 0, i8 1"
      , "  store i8 %active, ptr @yack_scratch_active, align 1"
      , "  ret void"
      , "}"
      , ""
      ]
    end

  fun heapArenaRuntime (poison, strict, limitText) =
    let
      val unpoisonUse =
        if poison then unpoisonCall "%bump" "%rounded" else []
      val unpoisonGrow =
        if poison then unpoisonCall "%data" "%rounded" else []
      val poisonChunk =
        if poison then
          [ "  %chunkdatap = getelementptr i8, ptr %chunk, i64 16"
          , "  %chunkdatasz = sub i64 %chunksize, 16"
          ] @ poisonCall "%chunkdatap" "%chunkdatasz"
        else []
      val releaseChunk =
        if strict then
          [ "  %qprev = load i64, ptr @yack_arena_qbytes, align 8"
          , "  %qnext = add i64 %qprev, %chunksize"
          , "  store i64 %qnext, ptr @yack_arena_qbytes, align 8"
          , "  %qover = icmp ugt i64 %qnext, " ^ limitText
          , "  br i1 %qover, label %quarantine.abort, label %free.done"
          ]
        else
          [ "  %oldfree = load ptr, ptr @yack_arena_free, align 8"
          , "  store ptr %oldfree, ptr %chunk"
          , "  store ptr %chunk, ptr @yack_arena_free, align 8"
          , "  br label %free.done"
          ]
      val quarantineAbort =
        if strict then
          [ "quarantine.abort:"
          , "  call void @yack_abort_msg(ptr @.yack_msg_quarantine)"
          , "  unreachable"
          ]
        else []
      val quarantineGlobal =
        if strict then
          [ "@yack_arena_qbytes = thread_local global i64 0" ]
        else []
    in
    [ "@yack_arena_depth = thread_local global i64 0"
    , "@yack_store_root = thread_local global i64 0"
    , "@yack_arena_bump = thread_local global ptr null, align 8"
    , "@yack_arena_end = thread_local global ptr null, align 8"
    , "@yack_arena_head = thread_local global ptr null, align 8"
    , "@yack_arena_free = thread_local global ptr null, align 8"
    , "@yack_arena_marks = thread_local global [64 x { ptr, ptr, ptr }] zeroinitializer"
    ]
    @ quarantineGlobal @
    [ ""
    , "define ptr @yack_arena_alloc(i64 %size) {"
    , "entry:"
    , "  %rounded0 = add i64 %size, 15"
    , "  %rounded = and i64 %rounded0, -16"
    , "  %bump = load ptr, ptr @yack_arena_bump, align 8"
    , "  %end = load ptr, ptr @yack_arena_end, align 8"
