import http_server/Server as Base
import net/Http
import web/Request
import web/Response
import web/Router

fun dispatch_text (text : consume string, app : Router.t) : string * Router.t =
    let val keep = Http.keep_alive (borrow text)
        val request = Request.parse (text)
    in
        case Router.dispatch (app, request) of
            (response, app) =>
                let val rendered =
                        if keep then Response.render_keepalive (response)
                        else Response.render (response)
                in
                    (rendered, app)
                end
    end

fun dispatcher () = { run = dispatch_text }

fun config (port : int) = Base.config (port)

fun reuse_port (settings : Base.config, enabled : bool) : Base.config =
    Base.reuse_port (settings, enabled)

(* Règle le nombre maximal de connexions simultanées (1..65536). *)
fun max_connections (settings : Base.config, value : int) : Base.config =
    Base.max_connections (settings, value)

(* Règle la taille du slot de requête, en-têtes et corps (>= 1024 octets). *)
fun max_request_bytes (settings : Base.config, value : int) : Base.config =
    Base.max_request_bytes (settings, value)

(* Règle la taille du slot de réponse (>= 1024 octets). *)
fun max_response_bytes (settings : Base.config, value : int) : Base.config =
    Base.max_response_bytes (settings, value)

(* Règle le délai maximal d'une requête commencée, en millisecondes (> 0). *)
fun request_timeout_ms (settings : Base.config, value : int64) : Base.config =
    Base.request_timeout_ms (settings, value)

(* Règle le délai d'inactivité keep-alive, en millisecondes (> 0). *)
fun idle_timeout_ms (settings : Base.config, value : int64) : Base.config =
    Base.idle_timeout_ms (settings, value)

(* Règle le délai maximal sans progrès d'écriture, en millisecondes (> 0). *)
fun write_timeout_ms (settings : Base.config, value : int64) : Base.config =
    Base.write_timeout_ms (settings, value)

fun run (app, settings) = Base.run (dispatcher (), app, settings)
