import net/Http
import yack/array
import yack/bytes
import yack/string
import yack/int

type 'state dispatcher = {
    run : (consume string, consume 'state) -> string * 'state
}

type 'state server = {
    epfd : int,
    listener_fd : int,
    fds : int32 array,
    events : int32 array,
    data : int8 array,
    lengths : int32 array,
    outputs : int8 array,
    output_lengths : int32 array,
    output_offsets : int32 array,
    conn_fds : int32 array,
    started : int64 array,
    active : int64 array,
    last_sweep : int64,
    dispatch : 'state dispatcher,
    state : 'state
}

fun max_connections () : int = 1024
fun buffer_size () : int = 4096
fun event_batch () : int = 64

(* A request whose first byte arrived must be complete within this delay,
   whatever the drip rate. This is what stops a slowloris client. *)
fun request_timeout_ms () : int64 = 10000
(* A keep-alive connection with nothing buffered and nothing to send. *)
fun idle_timeout_ms () : int64 = 30000
(* Pending output with no write progress, i.e. a client that does not read. *)
fun write_timeout_ms () : int64 = 10000

(* Interest masks: EPOLLIN = 1, EPOLLOUT = 4.  A connection is registered
   for exactly one direction at a time, so the slot token in the event is
   enough to know whether the next step is a read or a write flush. *)
fun set_interest (epfd : int, fd : int, slot : int, mask : int) : unit =
    let val _ = sys.epoll_mod_token (epfd, fd, mask, slot)
    in ()
    end

fun server_listen
    (port : int
    , shared : bool
    , dispatch : 'state dispatcher
    , state : 'state
    ) : 'state server result =
    let val epfd = sys.epoll_create ()
    in
        if epfd < 0 then
            let val error = sys.errno ()
            in
                Error
                    ("Http.run: epoll_create failed (errno " ^ int.to_string (error) ^ ")")
            end
        else
            let val fd = sys.socket_tcp ()
            in
                if fd < 0 then
                    let val error = sys.errno ()
                        val _ = sys.close (epfd)
                    in
                        Error
                            ("Http.run: socket failed (errno " ^ int.to_string (error) ^ ")")
                    end
                else
                    let val _ = sys.reuseaddr (fd)
                        (* SO_REUSEPORT is opt-in: by default a second instance
                           on the same port must fail with EADDRINUSE (98)
                           instead of silently sharing traffic. *)
                        val _ = if shared then sys.reuseport (fd) else 0
                        val bound = sys.bind_any (fd, port)
                    in
                        if bound < 0 then
                            let val error = sys.errno ()
                                val _ = sys.close (fd)
                                val _ = sys.close (epfd)
                            in
                                Error
                                    ("Http.run: bind failed on port " ^
                                     int.to_string (port) ^
                                     " (errno " ^
                                     int.to_string (error) ^
                                     ")")
                            end
                        else
                            let val listening = sys.listen (fd, 512)
                            in
                                if listening < 0 then
                                    let val error = sys.errno ()
                                        val _ = sys.close (fd)
                                        val _ = sys.close (epfd)
                                    in
                                        Error
                                            ("Http.run: listen failed (errno " ^
                                             int.to_string (error) ^
                                             ")")
                                    end
                                else
                                    let val _ = sys.set_nonblocking (fd)
                                        val max = max_connections ()
                                        val fds : int32 array = array.make (0, event_batch ())
                                        val events : int32 array = array.make (0, event_batch ())
                                        (* Slot buffers are never read before
                                           their length is written, so reserve
                                           them without touching every page.
                                           This keeps RSS proportional to the
                                           number of live connections. *)
                                        val data : int8 array = array.make_uninit (max * buffer_size ())
                                        val lengths : int32 array = array.make (0, max)
                                        val outputs : int8 array = array.make_uninit (max * buffer_size ())
                                        val output_lengths : int32 array = array.make (0, max)
                                        val output_offsets : int32 array = array.make (0, max)
                                        val conn_fds : int32 array = array.make (-1, max)
                                        val started : int64 array = array.make (-1, max)
                                        val active : int64 array = array.make (0, max)
                                        val last_sweep = sys.monotonic_ms ()
                                        val _ = sys.epoll_add_token (epfd, fd, 1, -1)
                                        val value : 'state server =
                                            { epfd = epfd
                                            , listener_fd = fd
                                            , fds = fds
                                            , events = events
                                            , data = data
                                            , lengths = lengths
                                            , outputs = outputs
                                            , output_lengths = output_lengths
                                            , output_offsets = output_offsets
                                            , conn_fds = conn_fds
                                            , started = started
                                            , active = active
                                            , last_sweep = last_sweep
                                            , dispatch = dispatch
                                            , state = state
                                            }
                                    in Ok (value)
                                    end
                            end
                    end
            end
    end

fun find_free_from (conn_fds : int32 array, index : int, limit : int) : int * int32 array =
    if index >= limit then (-1, conn_fds)
    else if array.get_int (borrow conn_fds, index) < 0 then (index, conn_fds)
    else find_free_from (conn_fds, index + 1, limit)

fun close_slot (value : 'state server, slot : int) : 'state server =
    case value of
        { epfd = epfd
        , listener_fd = listener_fd
        , fds = fds
        , events = events
        , data = data
        , lengths = lengths
        , outputs = outputs
        , output_lengths = output_lengths
        , output_offsets = output_offsets
        , conn_fds = conn_fds
        , started = started
        , active = active
        , last_sweep = last_sweep
                , dispatch = dispatch
                , state = state
        } =>
            let val fd = array.get_int (borrow conn_fds, slot)
                val _ = sys.close (fd)
                val _ = sys.epoll_del (epfd, fd)
                val conn_fds = array.set_int (conn_fds, slot, -1)
                val lengths = array.set_int (lengths, slot, 0)
                val output_lengths = array.set_int (output_lengths, slot, 0)
                val output_offsets = array.set_int (output_offsets, slot, 0)
                val started = array.set (started, slot, -1)
                val active = array.set (active, slot, 0)
            in
                { epfd = epfd
                , listener_fd = listener_fd
                , fds = fds
                , events = events
                , data = data
                , lengths = lengths
                , outputs = outputs
                , output_lengths = output_lengths
                , output_offsets = output_offsets
                , conn_fds = conn_fds
                , started = started
                , active = active
                , last_sweep = last_sweep
                , dispatch = dispatch
                , state = state
                }
            end

fun accept_loop (value : 'state server) : 'state server =
    case value of
        { epfd = epfd
        , listener_fd = listener_fd
        , fds = fds
        , events = events
        , data = data
        , lengths = lengths
        , outputs = outputs
        , output_lengths = output_lengths
        , output_offsets = output_offsets
        , conn_fds = conn_fds
        , started = started
        , active = active
        , last_sweep = last_sweep
        , dispatch = dispatch
        , state = state
        } =>
            let val client = sys.accept (listener_fd)
            in
                if client < 0 then
                    let val error = sys.errno ()
                        (* EMFILE/ENFILE: the listener stays readable, so
                           sleeping here caps the retry rate instead of
                           spinning at 100% CPU. *)
                        val _ =
                            if error = 24 then sys.sleep_ms (10)
                            else if error = 23 then sys.sleep_ms (10)
                            else ()
                    in
                        { epfd = epfd
                        , listener_fd = listener_fd
                        , fds = fds
                        , events = events
                        , data = data
                        , lengths = lengths
                        , outputs = outputs
                        , output_lengths = output_lengths
                        , output_offsets = output_offsets
                        , conn_fds = conn_fds
                        , started = started
                        , active = active
                        , last_sweep = last_sweep
                        , dispatch = dispatch
                        , state = state
                        }
                    end
                else
                    let val found = find_free_from (conn_fds, 0, max_connections ())
                        val slot = found.0
                        val next_conn_fds = found.1
                    in
                        if slot < 0 then
                            let val _ = sys.close (client)
                            in
                                { epfd = epfd
                                , listener_fd = listener_fd
                                , fds = fds
                                , events = events
                                , data = data
                                , lengths = lengths
                                , outputs = outputs
                                , output_lengths = output_lengths
                                , output_offsets = output_offsets
                                , conn_fds = next_conn_fds
                                , started = started
                                , active = active
                                , last_sweep = last_sweep
                                , dispatch = dispatch
                                , state = state
                                }
                            end
                        else
                            let val _ = sys.nodelay (client)
                                val conn_fds = array.set_int (next_conn_fds, slot, client)
                                val lengths = array.set_int (lengths, slot, 0)
                                val output_lengths = array.set_int (output_lengths, slot, 0)
                                val output_offsets = array.set_int (output_offsets, slot, 0)
                                val started = array.set (started, slot, -1)
                                val active = array.set (active, slot, sys.monotonic_ms ())
                                val _ = sys.epoll_add_token (epfd, client, 1, slot)
                            in
                                accept_loop
                                    ({ epfd = epfd
                                     , listener_fd = listener_fd
                                     , fds = fds
                                     , events = events
                                     , data = data
                                     , lengths = lengths
                                     , outputs = outputs
                                     , output_lengths = output_lengths
                                     , output_offsets = output_offsets
                                     , conn_fds = conn_fds
                                     , started = started
                                     , active = active
                                     , last_sweep = last_sweep
                                     , dispatch = dispatch
                                     , state = state
                                     })
                            end
                    end
            end

(* Render a complete keep-alive response into the connection output slot.
   The writer is bounded by `base + buffer_size ()`, so a response that does
   not fit is reported as a negative length instead of spilling into the next
   connection's slot. *)
fun render_response_into (output : int8 array, base : int, name : borrow string) : int8 array * int =
    let val name_length = string.length (name)
        val content_length = if name_length = 0 then 11 else 6 + name_length
        val prefix = "HTTP/1.1 200 OK\r\nContent-Length: "
        val separator = "\r\nConnection: keep-alive\r\n\r\n"
        val hello_world = "hello world"
        val hello_prefix = "hello "
        val limit = base + buffer_size ()
        val p0 = bytes.write_string (borrow output, base, limit, borrow prefix)
        val p1 = bytes.write_int (borrow output, p0, limit, content_length)
        val p2 = bytes.write_string (borrow output, p1, limit, borrow separator)
        val p3 =
            if name_length = 0 then
                bytes.write_string (borrow output, p2, limit, borrow hello_world)
            else
                let val p = bytes.write_string (borrow output, p2, limit, borrow hello_prefix)
                in bytes.write_string (borrow output, p, limit, name)
                end
    in
        if p3 < 0 then (output, p3) else (output, p3 - base)
    end

(* Try to drain the response slot.  `resuming` is true when the connection
   was woken by EPOLLOUT, so completion must switch the interest back to
   EPOLLIN.  On EAGAIN the slot keeps its offset and waits for EPOLLOUT. *)
fun flush_slot (value : 'state server, slot : int, resuming : bool) : 'state server =
    case value of
        { epfd = epfd
        , listener_fd = listener_fd
        , fds = fds
        , events = events
        , data = data
        , lengths = lengths
        , outputs = outputs
        , output_lengths = output_lengths
        , output_offsets = output_offsets
        , conn_fds = conn_fds
        , started = started
        , active = active
        , last_sweep = last_sweep
        , dispatch = dispatch
        , state = state
        } =>
            let val fd = array.get_int (borrow conn_fds, slot)
                val total = array.get_int (borrow output_lengths, slot)
                val offset = array.get_int (borrow output_offsets, slot)
                val base = slot * buffer_size ()
            in
                if offset >= total then
                    let val output_lengths = array.set_int (output_lengths, slot, 0)
                        val output_offsets = array.set_int (output_offsets, slot, 0)
                        val _ =
                            if resuming then set_interest (epfd, fd, slot, 1)
                            else ()
                    in
                        make_server
                            ( epfd
                            , listener_fd
                            , fds
                            , events
                            , data
                            , lengths
                            , outputs
                            , output_lengths
                            , output_offsets
                            , conn_fds
                            , started
                            , active
                            , last_sweep
                            , dispatch
                            , state
                            )
                    end
                else
                    let val sent = sys.send_from_raw (fd, outputs, base + offset, total - offset)
                    in
                        if sent < 0 then
                            let val error = sys.errno ()
                            in
                                if error = 11 then
                                    let val _ = set_interest (epfd, fd, slot, 4)
                                    in
                                        make_server
                                            ( epfd
                                            , listener_fd
                                            , fds
                                            , events
                                            , data
                                            , lengths
                                            , outputs
                                            , output_lengths
                                            , output_offsets
                                            , conn_fds
                                            , started
                                            , active
                                            , last_sweep
                                            , dispatch
                                            , state
                                            )
                                    end
                                else
                                    close_slot
                                        (make_server
                                             ( epfd
                                             , listener_fd
                                             , fds
                                             , events
                                             , data
                                             , lengths
                                             , outputs
                                             , output_lengths
                                             , output_offsets
                                             , conn_fds
                                             , started
                                             , active
                                             , last_sweep
                                             , dispatch
                                             , state
                                             ),
                                         slot)
                            end
                        else if sent = 0 then
                            let val _ = set_interest (epfd, fd, slot, 4)
                            in
                                make_server
                                    ( epfd
                                    , listener_fd
                                    , fds
                                    , events
                                    , data
                                    , lengths
                                    , outputs
                                    , output_lengths
                                    , output_offsets
                                    , conn_fds
                                    , started
                                    , active
                                    , last_sweep
                                    , dispatch
                                    , state
                                    )
                            end
                        else
                            let val next_offset = offset + sent
                                val output_offsets = array.set_int (output_offsets, slot, next_offset)
                                val active = array.set (active, slot, sys.monotonic_ms ())
                            in
                                if next_offset >= total then
                                    let val output_lengths = array.set_int (output_lengths, slot, 0)
                                        val output_offsets = array.set_int (output_offsets, slot, 0)
                                        val _ =
                                            if resuming then set_interest (epfd, fd, slot, 1)
                                            else ()
                                    in
                                        make_server
                                            ( epfd
                                            , listener_fd
                                            , fds
                                            , events
                                            , data
                                            , lengths
                                            , outputs
                                            , output_lengths
                                            , output_offsets
                                            , conn_fds
                                            , started
                                            , active
                                            , last_sweep
                                            , dispatch
                                            , state
                                            )
                                    end
                                else
                                    let val _ = set_interest (epfd, fd, slot, 4)
                                    in
                                        make_server
                                            ( epfd
                                            , listener_fd
                                            , fds
                                            , events
                                            , data
                                            , lengths
                                            , outputs
                                            , output_lengths
                                            , output_offsets
                                            , conn_fds
                                            , started
                                            , active
                                            , last_sweep
                                            , dispatch
                                            , state
                                            )
                                    end
                            end
                    end
            end

fun send_all_loop (fd : int, text : borrow string, offset : int, total : int) : unit =
    if offset >= total then ()
    else
        let val sent = sys.send_string_raw (fd, text, offset, total - offset)
        in
            if sent < 0 then
                let val error = sys.errno ()
                in
                    if error = 11 then send_all_loop (fd, text, offset, total)
                    else ()
                end
            else if sent = 0 then ()
            else send_all_loop (fd, text, offset + sent, total)
        end

fun send_all (fd : int, text : borrow string) : unit =
    let val total = string.length (text)
    in send_all_loop (fd, text, 0, total)
    end

fun send_hello (fd : int, body : borrow string) : unit =
    let val length = string.length (body)
        val length_text = int.to_string (length)
        val prefix = "HTTP/1.1 200 OK\r\nContent-Length: "
        val suffix = "\r\nConnection: keep-alive\r\n\r\n"
        val _ = send_all (fd, borrow prefix)
        val _ = send_all (fd, borrow length_text)
        val _ = send_all (fd, borrow suffix)
    in send_all (fd, body)
    end

fun make_server
    ( epfd : int
    , listener_fd : int
    , fds : int32 array
    , events : int32 array
    , data : int8 array
    , lengths : int32 array
    , outputs : int8 array
    , output_lengths : int32 array
    , output_offsets : int32 array
    , conn_fds : int32 array
    , started : int64 array
    , active : int64 array
    , last_sweep : int64
    , dispatch : 'state dispatcher
    , state : 'state
    ) : 'state server =
    { epfd = epfd
    , listener_fd = listener_fd
    , fds = fds
    , events = events
    , data = data
    , lengths = lengths
    , outputs = outputs
    , output_lengths = output_lengths
    , output_offsets = output_offsets
    , conn_fds = conn_fds
    , started = started
    , active = active
    , last_sweep = last_sweep
    , dispatch = dispatch
                , state = state
    }

(* Les méthodes sans corps n'ont pas besoin de lire Content-Length.
   La détection se fait sur les octets déjà lus : aucune chaîne temporaire
   n'est allouée avant l'entrée dans l'arène de la requête. *)
fun method_is_get (b0 : int8, b1 : int8, b2 : int8, b3 : int8) : bool =
    if b0 = 71 then
        if b1 = 69 then
            if b2 = 84 then b3 = 32
            else false
        else false
    else false

fun method_is_head
    (b0 : int8, b1 : int8, b2 : int8, b3 : int8, b4 : int8) : bool =
    if b0 = 72 then
        if b1 = 69 then
            if b2 = 65 then
                if b3 = 68 then b4 = 32
                else false
            else false
        else false
    else false

(* Longueur du corps annoncée par l'en-tête, à partir du bloc d'en-têtes
   brut (ligne de requête comprise). *)
fun content_length_of_headers (headers : string) : int =
    let val size = string.length (borrow headers)
        val first_cr = string.index_of_char_from (borrow headers, 0, 13)
        val header_start = first_cr + 2
        val header_stop = if size >= 4 then size - 4 else 0
        val name = "content-length"
        val found =
            Http.find_header_in_range
                (borrow headers, header_start, header_stop, borrow name)
    in
        case found of
            None => 0
          | Some value =>
                (case string_to_int (borrow value) of
                     Some parsed => parsed
                   | None => 0)
    end

fun handle_read (value : 'state server, slot : int) : 'state server =
    case value of
        { epfd = epfd
        , listener_fd = listener_fd
        , fds = fds
        , events = events
        , data = data
        , lengths = lengths
        , outputs = outputs
        , output_lengths = output_lengths
        , output_offsets = output_offsets
        , conn_fds = conn_fds
        , started = started
        , active = active
        , last_sweep = last_sweep
        , dispatch = dispatch
        , state = state
        } =>
            let val fd = array.get_int (borrow conn_fds, slot)
                val length = array.get_int (borrow lengths, slot)
                val start = slot * buffer_size ()
                val available = buffer_size () - length
            in
                if available <= 0 then
                    close_slot
                        (make_server
                             ( epfd
                             , listener_fd
                             , fds
                             , events
                             , data
                             , lengths
                             , outputs
                             , output_lengths
                             , output_offsets
                             , conn_fds
                             , started
                             , active
                             , last_sweep
                             , dispatch
                             , state
                             ),
                         slot)
                else
                    let val received = sys.recv_into_raw (fd, data, start + length, available)
                    in
                        if received < 0 then
                            let val error = sys.errno ()
                            in
                                if error = 11 then
                                    make_server
                                        ( epfd
                                        , listener_fd
                                        , fds
                                        , events
                                        , data
                                        , lengths
                                        , outputs
                                        , output_lengths
                                        , output_offsets
                                        , conn_fds
                                        , started
                                        , active
                                        , last_sweep
                                        , dispatch
                                        , state
                                        )
                                else
                                    close_slot
                                        (make_server
                                             ( epfd
                                             , listener_fd
                                             , fds
                                             , events
                                             , data
                                             , lengths
                                             , outputs
                                             , output_lengths
                                             , output_offsets
                                             , conn_fds
                                             , started
                                             , active
                                             , last_sweep
                                             , dispatch
                                             , state
                                             ),
                                         slot)
                            end
                        else if received = 0 then
                            close_slot
                                (make_server
                                     ( epfd
                                     , listener_fd
                                     , fds
                                     , events
                                     , data
                                     , lengths
                                     , outputs
                                     , output_lengths
                                     , output_offsets
                                     , conn_fds
                                     , started
                                     , active
                                     , last_sweep
                                     , dispatch
                                     , state
                                     ),
                                 slot)
                        else
                            let val next_length = length + received
                                val lengths = array.set_int (lengths, slot, next_length)
                                val active = array.set (active, slot, sys.monotonic_ms ())
                                val started =
                                    if length = 0 then
                                        array.set (started, slot, sys.monotonic_ms ())
                                    else started
                                val end_index = bytes.header_end (borrow data, start, start + next_length)
                            in
                                if end_index < 0 then
                                    make_server
                                        ( epfd
                                        , listener_fd
                                        , fds
                                        , events
                                        , data
                                        , lengths
                                        , outputs
                                        , output_lengths
                                        , output_offsets
                                        , conn_fds
                                        , started
                                        , active
                                        , last_sweep
                                        , dispatch
                                        , state
                                        )
                                else
                                    let val bodyless =
                                            if next_length < 4 then false
                                            else
                                                let val b0 = array.get (borrow data, start)
                                                    val b1 = array.get (borrow data, start + 1)
                                                    val b2 = array.get (borrow data, start + 2)
                                                    val b3 = array.get (borrow data, start + 3)
                                                in
                                                    if method_is_get (b0, b1, b2, b3) then true
                                                    else if next_length < 5 then false
                                                    else
                                                        method_is_head
                                                            ( b0
                                                            , b1
                                                            , b2
                                                            , b3
                                                            , array.get (borrow data, start + 4)
                                                            )
                                                end
                                        val header_length = end_index - start
                                        val expected =
                                            if bodyless then header_length
                                            else
                                                arena
                                                    val headers =
                                                        bytes.to_string_range
                                                            (borrow data, start, header_length)
                                                    val content_length =
                                                        content_length_of_headers (headers)
                                                in
                                                    header_length + content_length
                                                end
                                    in
                                        if next_length < expected then
                                            make_server
                                                ( epfd
                                                , listener_fd
                                                , fds
                                                , events
                                                , data
                                                , lengths
                                                , outputs
                                                , output_lengths
                                                , output_offsets
                                                , conn_fds
                                                , started
                                                , active
                                                , last_sweep
                                                , dispatch
                                                , state
                                                )
                                        else
                                            let val run = dispatch.run
                                                val result =
                                                    arena
                                                        val request_text =
                                                            bytes.to_string_range
                                                                (borrow data, start, next_length)
                                                        val dispatched =
                                                            run (request_text, state)
                                                    in
                                                        case dispatched of
                                                            (response, next_state) =>
                                                                let val limit = start + buffer_size ()
                                                                    val rendered_end =
                                                                        bytes.write_string
                                                                            (borrow outputs, start, limit, borrow response)
                                                                    val response_length =
                                                                        if rendered_end < 0 then -1
                                                                        else rendered_end - start
                                                                in
                                                                    (next_state, response_length)
                                                                end
                                                    end
                                            in
                                                case result of
                                                    (next_state, response_length) =>
                                                        if response_length < 0 then
                                                            close_slot
                                                                (make_server
                                                                     ( epfd
                                                                     , listener_fd
                                                                     , fds
                                                                     , events
                                                                     , data
                                                                     , lengths
                                                                     , outputs
                                                                     , output_lengths
                                                                     , output_offsets
                                                                     , conn_fds
                                                                     , started
                                                                     , active
                                                                     , last_sweep
                                                                     , dispatch
                                                                     , next_state
                                                                     ),
                                                                 slot)
                                                        else
                                                            let val lengths = array.set_int (lengths, slot, 0)
                                                                val output_lengths = array.set_int (output_lengths, slot, response_length)
                                                                val output_offsets = array.set_int (output_offsets, slot, 0)
                                                                val started = array.set (started, slot, -1)
                                                            in
                                                                flush_slot
                                                                    (make_server
                                                                         ( epfd
                                                                         , listener_fd
                                                                         , fds
                                                                         , events
                                                                         , data
                                                                         , lengths
                                                                         , outputs
                                                                         , output_lengths
                                                                         , output_offsets
                                                                         , conn_fds
                                                                         , started
                                                                         , active
                                                                         , last_sweep
                                                                         , dispatch
                                                                         , next_state
                                                                         ),
                                                                     slot,
                                                                     false)
                                                            end
                                            end
                                    end
                            end
                    end
            end

fun handle_events (value : 'state server, count : int, index : int) : 'state server =
    if index >= count then value
    else
        case value of
            { epfd = epfd
            , listener_fd = listener_fd
            , fds = fds
            , events = events
            , data = data
            , lengths = lengths
            , outputs = outputs
            , output_lengths = output_lengths
            , output_offsets = output_offsets
            , conn_fds = conn_fds
            , started = started
            , active = active
            , last_sweep = last_sweep
                , dispatch = dispatch
                , state = state
            } =>
                let val token = array.get_int (borrow fds, index)
                    val pending =
                        if token < 0 then false
                        else
                            array.get_int (borrow output_offsets, token) <
                            array.get_int (borrow output_lengths, token)
                    val rebuilt : 'state server =
                        { epfd = epfd
                        , listener_fd = listener_fd
                        , fds = fds
                        , events = events
                        , data = data
                        , lengths = lengths
                        , outputs = outputs
                        , output_lengths = output_lengths
                        , output_offsets = output_offsets
                        , conn_fds = conn_fds
                        , started = started
                        , active = active
                        , last_sweep = last_sweep
                , dispatch = dispatch
                , state = state
                        }
                    val next_value =
                        if token < 0 then accept_loop (rebuilt)
                        else if pending then flush_slot (rebuilt, token, true)
                        else handle_read (rebuilt, token)
                in handle_events (next_value, count, index + 1)
                end

fun close_slots_from (conn_fds : int32 array, index : int) : unit =
    if index >= max_connections () then
        ()
    else
        let val fd = array.get_int (borrow conn_fds, index)
            val _ = if fd >= 0 then (let val _ = sys.close (fd) in () end) else ()
        in
            close_slots_from (conn_fds, index + 1)
        end

fun close_all (value : 'state server) : unit =
    case value of
        { epfd = epfd
        , listener_fd = listener_fd
        , fds = fds
        , events = events
        , data = data
        , lengths = lengths
        , outputs = outputs
        , output_lengths = output_lengths
        , output_offsets = output_offsets
        , conn_fds = conn_fds
        , started = started
        , active = active
        , last_sweep = last_sweep
        , dispatch = dispatch
        , state = state
        } =>
            let val _ = close_slots_from (conn_fds, 0)
                val _ = sys.close (listener_fd)
                val _ = sys.close (epfd)
            in
                ()
            end

(* Close every connection that exceeded one of the three time budgets.
   Scans the whole slot table with plain record rebuilds and no heap
   allocation; a slot is only closed through close_slot, which already
   removes it from epoll and resets its timestamps. *)
fun sweep_from (value : 'state server, index : int, now : int64) : 'state server =
    if index >= max_connections () then value
    else
        case value of
            { epfd = epfd
            , listener_fd = listener_fd
            , fds = fds
            , events = events
            , data = data
            , lengths = lengths
            , outputs = outputs
            , output_lengths = output_lengths
            , output_offsets = output_offsets
            , conn_fds = conn_fds
            , started = started
            , active = active
            , last_sweep = last_sweep
            , dispatch = dispatch
            , state = state
            } =>
                let val fd = array.get_int (borrow conn_fds, index)
                    val request_started = array.get (borrow started, index)
                    val last_active = array.get (borrow active, index)
                    val pending =
                        array.get_int (borrow output_offsets, index) <
                        array.get_int (borrow output_lengths, index)
                    val rebuilt : 'state server =
                        { epfd = epfd
                        , listener_fd = listener_fd
                        , fds = fds
                        , events = events
                        , data = data
                        , lengths = lengths
                        , outputs = outputs
                        , output_lengths = output_lengths
                        , output_offsets = output_offsets
                        , conn_fds = conn_fds
                        , started = started
                        , active = active
                        , last_sweep = last_sweep
                        , dispatch = dispatch
                        , state = state
                        }
                in
                    if fd < 0 then sweep_from (rebuilt, index + 1, now)
                    else
                        let val expired =
                                if request_started >= 0 then
                                    now - request_started > request_timeout_ms ()
                                else if pending then
                                    now - last_active > write_timeout_ms ()
                                else
                                    now - last_active > idle_timeout_ms ()
                        in
                            if expired then
                                sweep_from (close_slot (rebuilt, index), index + 1, now)
                            else sweep_from (rebuilt, index + 1, now)
                        end
                end

fun serve (value : 'state server) : unit result =
    if sys.stop_requested () then
        let val _ = close_all (value)
        in Ok (())
        end
    else
        case value of
            { epfd = epfd
            , listener_fd = listener_fd
            , fds = fds
            , events = events
            , data = data
            , lengths = lengths
            , outputs = outputs
            , output_lengths = output_lengths
            , output_offsets = output_offsets
            , conn_fds = conn_fds
            , started = started
            , active = active
            , last_sweep = last_sweep
            , dispatch = dispatch
            , state = state
            } =>
                let val ready = sys.epoll_wait (epfd, fds, events, event_batch (), 200)
                    val now = sys.monotonic_ms ()
                    val sweep_due = now - last_sweep >= 1000
                    val rebuilt : 'state server =
                        { epfd = epfd
                        , listener_fd = listener_fd
                        , fds = fds
                        , events = events
                        , data = data
                        , lengths = lengths
                        , outputs = outputs
                        , output_lengths = output_lengths
                        , output_offsets = output_offsets
                        , conn_fds = conn_fds
                        , started = started
                        , active = active
                        , last_sweep = if sweep_due then now else last_sweep
                        , dispatch = dispatch
                        , state = state
                        }
                    val current =
                        if sweep_due then sweep_from (rebuilt, 0, now)
                        else rebuilt
                in
                    if sys.stop_requested () then
                        let val _ = close_all (current)
                        in Ok (())
                        end
                    else if ready < 0 then
                        let val error = sys.errno ()
                        in
                            if error = 4 then serve (current)
                            else if error = 11 then serve (current)
                            else
                                let val _ = close_all (current)
                                in
                                    Error
                                        ("Http.run: epoll_wait failed (errno " ^
                                         int.to_string (error) ^
                                         ")")
                                end
                        end
                    else if ready = 0 then serve (current)
                    else serve (handle_events (current, ready, 0))
                end

type config : Affine =
    { port : int,
      reuse_port : bool
    }

fun config (port : int) : config =
    { port = port, reuse_port = false }

(* Active ou désactive SO_REUSEPORT.
   - `settings` : configuration à modifier.
   - `enabled` : `true` laisse plusieurs processus partager le port ; le
     noyau répartit alors les connexions entre eux.

   Désactivé par défaut : un second processus sur le même port échoue avec
   EADDRINUSE (errno 98) au lieu de mélanger deux versions du serveur. *)
fun reuse_port (settings : config, enabled : bool) : config =
    { port = settings.port, reuse_port = enabled }

fun run
    (dispatch : 'state dispatcher, state : 'state, settings : config)
    : unit result =
    case server_listen (settings.port, settings.reuse_port, dispatch, state) of
        Error (message) => Error (message)
      | Ok (value) =>
            let val _ = sys.install_stop_signals ()
            in serve (value)
            end
