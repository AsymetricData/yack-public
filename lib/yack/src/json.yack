import yack/char

import yack/list

import yack/string

(* Représente une valeur JSON sous forme d'arbre immuable.
   - `Null` : valeur JSON nulle ; `Bool` : booléen.
   - `Number` : texte du nombre, conservé sans conversion flottante.
   - `String` : chaîne décodée ; `Array` : liste ordonnée de valeurs.
   - `Object` : liste ordonnée de couples clé-valeur.

   Les constructeurs avec données prennent possession de leurs arguments ; ce type
   sert à construire, analyser et rendre des documents JSON. *)
datatype value =
    Null
  | Bool of bool
  | Number of string
  | String of string
  | Array of value list
  | Object of (string, value) list

(* Teste si un flottant est fini, sans `is_nan` du noyau.
   - `value` : flottant examiné.

   Retourne faux pour `inf` et `nan`. `nan` est le seul cas où
   `value <= value` est faux ; `inf` dépasse le plus grand flottant fini. *)
fun internal_float_is_finite (value : float) : bool =
    if value <= value then
        if value > 1.7976931348623157e308 then
            false
        else if value < 0.0 - 1.7976931348623157e308 then
            false
        else
            true
    else
        false

(* Construit la valeur JSON nulle, sans argument ni mutation. *)
fun null () : value = Null

(* Emballe un booléen comme valeur JSON.
   - `input` : booléen scalaire consommé.

   Retourne une nouvelle valeur `Bool`. *)
fun bool (input : bool) : value = Bool (input)

(* Convertit un entier 32 bits en valeur JSON numérique.
   - `input` : entier scalaire consommé.

   Retourne `Number` contenant son texte décimal. *)
fun int (input : int) : value = Number (int_to_string (input))

(* Convertit un entier 64 bits en valeur JSON numérique.
   - `input` : entier 64 bits consommé.

   Retourne `Number` contenant son texte décimal. *)
fun int64 (input : int64) : value = Number (int64_to_string (input))

(* Convertit un flottant en valeur JSON numérique.
   - `input` : flottant consommé.

   Retourne `Number` contenant `float_to_string (input)`, dont le texte est
   le plus court qui relit exactement le même flottant. Un flottant non fini
   (`inf`, `nan`) n'a pas de représentation JSON : le résultat est `Null`,
   comme `JSON.stringify`. *)
fun float (input : float) : value =
    if internal_float_is_finite (input) then
        Number (float_to_string (input))
    else
        Null

(* Construit un nombre depuis sa représentation textuelle.
   - `input` : texte consommé et conservé tel quel, sans validation.

   Retourne une valeur `Number`. Préférer `int`, `int64` ou `float` quand le
   type est connu ; `number` sert aux lexèmes déjà validés par `parse`. *)
fun number (input : string) : value = Number (input)

(* Emballe une chaîne comme valeur JSON.
   - `input` : chaîne consommée et stockée sans échappement préalable.

   Retourne une nouvelle valeur `String` ; `to_string` ajoute les
   guillemets et les échappements. *)
fun string (input : string) : value = String (input)

(* Construit un tableau JSON depuis une liste ordonnée.
   - `values` : liste de valeurs consommée par le constructeur.

   Retourne `Array` sans modifier les éléments. *)
fun array (values : value list) : value = Array (values)

(* Encode chaque élément d'une liste avec une fonction nommée.
   - `f` : encodeur d'un élément, qui consomme sa valeur.
   - `values` : éléments consommés dans l'ordre.

   Retourne `Array` des valeurs encodées, dans l'ordre source. *)
fun list (f : !'a -> value, values : 'a list) : value = Array (list_from (f, values, Nil))

(* Parcours de `list` avec un accumulateur inversé.
   - `f` : encodeur d'un élément, consommé par le parcours.
   - `values` : éléments restants, consommés.
   - `acc` : valeurs encodées en ordre inverse. *)
fun list_from (f : !'a -> value, values : 'a list, acc : value list) : value list =
    case values of
        Nil => list.reverse (acc)
      | Cons (value, rest) =>
            list_from (f, rest, Cons ((f (value), acc)))

(* Construit un objet JSON depuis une liste ordonnée de champs.
   - `fields` : couples clé-valeur consommés par le constructeur.

   Retourne `Object` ; les clés répétées sont conservées et l'ordre de la
   liste est celui du document rendu. *)
fun object (fields : (string, value) list) : value = Object (fields)

(* Encode un `option` : `None` devient `null`, `Some` passe à `f`.
   - `f` : encodeur de la valeur présente, qui la consomme.
   - `value` : option consommée.

   Retourne `Null` pour `None`, sinon la valeur encodée par `f`. *)
fun nullable (f : !'a -> value, value : 'a option) : value =
    case value of
        None => Null
      | Some (inner) => f (inner)

(* Assemble une clé et sa valeur en entrée d'objet.
   - `name` : nom de clé consommé.
   - `value` : valeur associée consommée.

   Retourne le couple, sans mutation. *)
fun entry (name : string, value : value) : string * value = (name, value)

(* Avance sur les espaces depuis un index dans l'entrée empruntée.
   - `text` : texte source emprunté, non modifié.
   - `index` : position initiale incluse.
   - `size` : limite exclusive de lecture.

   Retourne le premier index non-espace, ou la limite si elle est atteinte. *)
fun skip_space (text : borrow string, index : int, size : int) : int =
    if index >= size then
        index
    else if char.is_space_code (string.char_at_unchecked (text, index)) then
        skip_space (text, index + 1, size)
    else
        index

(* Convertit un code ASCII hexadécimal en valeur entière.
   - `code` : code du caractère à examiner.

   Retourne une valeur de 0 à 15, ou -1 si le code n'est pas hexadécimal. *)
fun hex_digit_value (code : int) : int =
    if code >= 48 then
        if code <= 57 then
            code - 48
        else if code >= 65 then
            if code <= 70 then
                code - 55
            else if code >= 97 then if code <= 102 then code - 87 else -1 else -1
        else
            -1
    else
        -1

(* Analyse récursivement quatre chiffres hexadécimaux.
   - `text` : entrée empruntée, non modifiée.
   - `index` : position du prochain chiffre.
   - `size` : limite exclusive de lecture.
   - `count` : nombre de chiffres déjà lus, entre 0 et 4.
   - `acc` : valeur déjà accumulée.

   Retourne la valeur décodée ou `None` si l'entrée est incomplète/invalide. *)
fun parse_hex4_from (
    text : borrow string,
    index : int,
    size : int,
    count : int,
    acc : int
) : int option =
    if count = 4 then
        Some (acc)
    else if index >= size then
        None
    else
        let
            val digit = hex_digit_value (string.char_at_unchecked (text, index))
        in
            if digit < 0 then
                None
            else
                parse_hex4_from (text, index + 1, size, count + 1, acc * 16 + digit)
        end

(* Lit quatre chiffres hexadécimaux à la position donnée.
   - `text` : entrée empruntée, non modifiée.
   - `index` : index du premier chiffre.
   - `size` : limite exclusive de lecture.

   Retourne la valeur décodée, ou `None` si les chiffres sont absents/invalides. *)
fun parse_hex4 (text : borrow string, index : int, size : int) : int option =
    parse_hex4_from (text, index, size, 0, 0)

(* Encode en UTF-8 un point de code pris en charge.
   - `code` : point de code à encoder.

   Retourne `Some` chaîne UTF-8, ou `None` pour un point invalide/non pris en charge,
   notamment les substituts UTF-16. *)
fun utf8_of_code (code : int) : string option =
    if code < 0 then
        None
    else if code < 128 then
        Some (string_of_char (code))
    else if code < 2048 then
        Some (string_of_char (192 + code / 64) ^ string_of_char (128 + code % 64))
    else if code < 65536 then
        if code >= 55296 then
            if code <= 57343 then
                None
            else
                Some (
                    string_of_char (224 + code / 4096) ^
                        string_of_char (128 + code / 64 % 64) ^
                        string_of_char (128 + code % 64)
                )
        else
            Some (
                string_of_char (224 + code / 4096) ^
                    string_of_char (128 + code / 64 % 64) ^
                    string_of_char (128 + code % 64)
            )
    else
        None

(* Décode un échappement JSON à partir du caractère suivant `\\`.
   - `text` : entrée empruntée, non modifiée.
   - `index` : position du caractère qui suit la barre inverse.
   - `size` : limite exclusive de l'entrée.

   Retourne le fragment décodé et l'index suivant, ou une erreur descriptive. *)
fun parse_escape (text : borrow string, index : int, size : int) : (string, int) result =
    if index >= size then
        Error ("unterminated escape at " ^ int_to_string (index))
    else
        let
            val code = string.char_at_unchecked (text, index)
        in
            if code = 34 then
                Ok ((string_of_char (34), index + 1))
            else if code = 92 then
                Ok ((string_of_char (92), index + 1))
            else if code = 47 then
                Ok ((string_of_char (47), index + 1))
            else if code = 110 then
                Ok ((string_of_char (10), index + 1))
            else if code = 114 then
                Ok ((string_of_char (13), index + 1))
            else if code = 116 then
                Ok ((string_of_char (9), index + 1))
            else if code = 98 then
                Ok ((string_of_char (8), index + 1))
            else if code = 102 then
                Ok ((string_of_char (12), index + 1))
            else if code = 117 then
                let
                    val parsed = parse_hex4 (text, index + 1, size)
                in
                    case parsed of
                        None => Error ("invalid \\u escape at " ^ int_to_string (index))
                      | Some value =>
                          case utf8_of_code (value) of
                              None =>
                                  Error (
                                      "unsupported \\u code point at " ^
                                          int_to_string (index)
                                  )
                            | Some encoded => Ok ((encoded, index + 5))
                end
            else
                Error ("unknown escape at " ^ int_to_string (index))
        end

(* Cherche la fin d'une plage de contenu de chaîne sans échappement.
   - `text` : source empruntée, non modifiée.
   - `index` : début de la plage.
   - `size` : limite exclusive de lecture.

   Retourne l'index du prochain guillemet ou de la prochaine barre inverse. *)
fun internal_string_run_end (text : borrow string, index : int, size : int) : int =
    if index >= size then
        index
    else
        let val code = string.char_at_unchecked (text, index)
        in
            if code = 34 then
                index
            else if code = 92 then
                index
            else
                internal_string_run_end (text, index + 1, size)
        end

(* Accumule les morceaux décodés jusqu'au guillemet fermant d'une chaîne.
   - `text` : source empruntée, non modifiée.
   - `index` : position du prochain caractère.
   - `size` : limite exclusive de lecture.
   - `acc` : morceaux décodés en ordre inverse.

   Retourne les morceaux et l'index après le guillemet, ou une erreur. Les
   plages sans échappement sont copiées d'un seul coup, donc le coût est
   linéaire même pour une grande chaîne. *)
fun parse_string_chunks (
    text : borrow string,
    index : int,
    size : int,
    acc : string list
) : (string list, int) result =
    if index >= size then
        Error ("unterminated string at " ^ int_to_string (index))
    else
        let
            val code = string.char_at_unchecked (text, index)
        in
            if code = 34 then
                Ok ((list.reverse (acc), index + 1))
            else if code = 92 then
                let
                    val escaped = parse_escape (text, index + 1, size)
                in
                    case escaped of
                        Error message => Error (message)
                      | Ok (decoded, next) =>
                          parse_string_chunks (text, next, size, Cons ((decoded, acc)))
                end
            else
                let val stop = internal_string_run_end (text, index, size)
                in
                    parse_string_chunks (
                        text,
                        stop,
                        size,
                        Cons ((string.slice (text, index, stop), acc))
                    )
                end
        end

(* Analyse une chaîne JSON dont le guillemet ouvrant est à `index`.
   - `text` : source empruntée, non modifiée.
   - `index` : position attendue du guillemet ouvrant.
   - `size` : limite exclusive de l'entrée.

   Retourne le contenu décodé et l'index suivant, ou une erreur de syntaxe. *)
fun parse_string (text : borrow string, index : int, size : int) : (string, int) result =
    if index >= size then
        Error ("expected string at " ^ int_to_string (index))
    else if string.char_at_unchecked (text, index) <> 34 then
        Error ("expected string at " ^ int_to_string (index))
    else
        case parse_string_chunks (text, index + 1, size, Nil) of
            Error (message) => Error (message)
          | Ok (chunks, next) => Ok ((internal_concat (chunks), next))

(* Teste si un code ASCII peut faire partie d'un littéral numérique.
   - `code` : code du caractère examiné.

   Retourne vrai pour chiffres, signes, point et marqueurs d'exposant ; ce test
   lexical seul ne garantit pas la validité complète du nombre. *)
fun is_number_char (code : int) : bool =
    if code >= 48 then
        if code <= 57 then
            true
        else if code = 101 then true else if code = 69 then true else false
    else if code = 45 then
        true
    else if code = 43 then true else if code = 46 then true else false

(* Cherche la fin du groupe contigu de caractères numériques.
   - `text` : entrée empruntée, non modifiée.
   - `index` : début du groupe.
   - `size` : limite exclusive.

   Retourne l'index du premier caractère qui ne peut appartenir au groupe. *)
fun number_end (text : borrow string, index : int, size : int) : int =
    if index >= size then
        index
    else if is_number_char (string.char_at_unchecked (text, index)) then
        number_end (text, index + 1, size)
    else
        index

(* Lit un littéral numérique en conservant son texte source.
   - `text` : entrée empruntée, non modifiée.
   - `index` : début de la séquence.
   - `size` : limite exclusive de lecture.

   Retourne `Number` et l'index final, ou une erreur si aucun caractère numérique
   n'est trouvé ; la validation de grammaire reste minimale. *)
fun parse_number (text : borrow string, index : int, size : int) : (value, int) result =
    let
        val stop = number_end (text, index, size)
        val literal = string.slice (text, index, stop)
    in
        if stop = index then
            Error ("expected number at " ^ int_to_string (index))
        else
            Ok ((Number (literal), stop))
    end

(* Vérifie la présence d'un littéral à une position de l'entrée.
   - `text` : entrée empruntée, non modifiée.
   - `index` : position où commence le texte attendu.
   - `size` : limite exclusive de l'entrée.
   - `literal` : texte à comparer, emprunté pendant la comparaison.
   - `value` : valeur à rendre en cas de correspondance, consommée.

   Retourne la valeur et l'index suivant, ou une erreur précisant la position. *)
fun expect_literal (
    text : borrow string,
    index : int,
    size : int,
    literal : string,
    value : value
) : (value, int) result =
    let
        val literalSize = string.length (borrow literal)
    in
        if index + literalSize > size then
            Error (
                "expected `" ^ string.copy (borrow literal) ^ "` at " ^
                    int_to_string (index)
            )
        else
            let
                val candidate = string.slice (text, index, index + literalSize)
            in
                if string.equals (borrow candidate, borrow literal) then
                    Ok ((value, index + literalSize))
                else
                    Error (
                        "expected `" ^ string.copy (borrow literal) ^ "` at " ^
                            int_to_string (index)
                    )
            end
    end

(* Analyse récursivement les éléments d'un tableau déjà ouvert.
   - `text` : entrée empruntée, non modifiée.
   - `index` : début du prochain élément.
   - `size` : limite exclusive de l'entrée.
   - `acc` : éléments lus en ordre inverse, consommés puis complétés.

   Retourne les valeurs en ordre source et l'index après `]`, ou une erreur de
   syntaxe/terminaison. *)
fun parse_array_items (text : borrow string, index : int, size : int, acc : value list) : (value list, int) result =
    let
        val parsed = parse_value (text, index, size)
    in
        case parsed of
            Error message => Error (message)
          | Ok (value, next) =>
              let
                  val after = skip_space (text, next, size)
              in
                  if after >= size then
                      Error ("unterminated array at " ^ int_to_string (after))
                  else if string.char_at_unchecked (text, after) = 44 then
                      let
                          val start = skip_space (text, after + 1, size)
                      in
                          parse_array_items (text, start, size, Cons ((value, acc)))
                      end
                  else if string.char_at_unchecked (text, after) = 93 then
                      Ok ((list.reverse (Cons ((value, acc))), after + 1))
                  else
                      Error ("expected `,` or `]` at " ^ int_to_string (after))
              end
    end

(* Analyse un tableau JSON ouvert à l'index indiqué.
   - `text` : entrée empruntée, non modifiée.
   - `index` : position du crochet ouvrant.
   - `size` : limite exclusive de lecture.

   Retourne le tableau et l'index après `]`, ou une erreur de syntaxe. *)
fun parse_array (text : borrow string, index : int, size : int) : (value, int) result =
    let
        val start = skip_space (text, index + 1, size)
    in
        if start >= size then
            Error ("unterminated array at " ^ int_to_string (start))
        else if string.char_at_unchecked (text, start) = 93 then
            Ok ((Array (Nil), start + 1))
        else
            let
                val items = parse_array_items (text, start, size, Nil)
            in
                case items of
                    Error message => Error (message)
                  | Ok (values, next) => Ok ((Array (values), next))
            end
    end

(* Analyse récursivement les champs d'un objet déjà ouvert.
   - `text` : entrée empruntée, non modifiée.
   - `index` : début de la prochaine clé JSON.
   - `size` : limite exclusive de l'entrée.
   - `acc` : couples déjà lus en ordre inverse, consommés puis complétés.

   Retourne les couples dans l'ordre source et l'index après `}`, ou une erreur pour
   clé, séparateur, valeur ou terminaison invalide. *)
fun parse_object_items (
    text : borrow string,
    index : int,
    size : int,
    acc : (string, value) list
) : ((string, value) list, int) result =
    let
        val parsedKey = parse_string (text, index, size)
    in
        case parsedKey of
            Error message => Error (message)
          | Ok (key, afterKey) =>
              let
                  val colon = skip_space (text, afterKey, size)
              in
                  if colon >= size then
                      Error ("unterminated object at " ^ int_to_string (colon))
                  else if string.char_at_unchecked (text, colon) <> 58 then
                      Error ("expected `:` at " ^ int_to_string (colon))
                  else
                      let
                          val parsedValue = parse_value (text, colon + 1, size)
                      in
                          case parsedValue of
                              Error message => Error (message)
                            | Ok (value, next) =>
                                let
                                    val after = skip_space (text, next, size)
                                in
                                    if after >= size then
                                        Error (
                                            "unterminated object at " ^
                                                int_to_string (after)
                                        )
                                    else if string.char_at_unchecked (text, after) = 44 then
                                        let
                                            val start =
                                                skip_space (text, after + 1, size)
                                        in
                                            parse_object_items (
                                                text,
                                                start,
                                                size,
                                                Cons (((key, value), acc))
                                            )
                                        end
                                    else if string.char_at_unchecked (text, after) = 125 then
                                        Ok (
                                            (
                                                list.reverse (
                                                    Cons (((key, value), acc))
                                                ),
                                                after + 1
                                            )
                                        )
                                    else
                                        Error (
                                            "expected `,` or `}` at " ^
                                                int_to_string (after)
                                        )
                                end
                      end
              end
    end

(* Analyse un objet JSON ouvert à l'index indiqué.
   - `text` : entrée empruntée, non modifiée.
   - `index` : position de l'accolade ouvrante.
   - `size` : limite exclusive de lecture.

   Retourne l'objet et l'index après `}`, ou une erreur de syntaxe. *)
fun parse_object (text : borrow string, index : int, size : int) : (value, int) result =
    let
        val start = skip_space (text, index + 1, size)
    in
        if start >= size then
            Error ("unterminated object at " ^ int_to_string (start))
        else if string.char_at_unchecked (text, start) = 125 then
            Ok ((Object (Nil), start + 1))
        else
            let
                val items = parse_object_items (text, start, size, Nil)
            in
                case items of
                    Error message => Error (message)
                  | Ok (pairs, next) => Ok ((Object (pairs), next))
            end
    end

(* Analyse une valeur JSON depuis un index, en sautant les espaces initiaux.
   - `text` : texte source emprunté, jamais modifié.
   - `index` : position de départ.
   - `size` : limite exclusive de lecture.

   Retourne la valeur et l'index suivant, ou une erreur si la syntaxe est invalide ou
   l'entrée épuisée. *)
fun parse_value (text : borrow string, index : int, size : int) : (value, int) result =
    let
        val start = skip_space (text, index, size)
    in
        if start >= size then
            Error ("unexpected end of input")
        else
            let
                val code = string.char_at_unchecked (text, start)
            in
                if code = 123 then
                    parse_object (text, start, size)
                else if code = 91 then
                    parse_array (text, start, size)
                else if code = 34 then
                    let
                        val parsed = parse_string (text, start, size)
                    in
                        case parsed of
                            Error message => Error (message)
                          | Ok (textValue, next) => Ok ((String (textValue), next))
                    end
                else if code = 116 then
                    expect_literal (text, start, size, "true", Bool (true))
                else if code = 102 then
                    expect_literal (text, start, size, "false", Bool (false))
                else if code = 110 then
                    expect_literal (text, start, size, "null", Null)
                else if code = 45 then
                    parse_number (text, start, size)
                else if code >= 48 then
                    if code <= 57 then
                        parse_number (text, start, size)
                    else
                        Error ("unexpected character at " ^ int_to_string (start))
                else
                    Error ("unexpected character at " ^ int_to_string (start))
            end
    end

(* Analyse un document JSON entier et rejette les caractères finaux superflus.
   - `text` : document emprunté, non modifié.

   Retourne l'arbre JSON analysé, ou une erreur de syntaxe descriptive. *)
fun parse (text : &string) : value result =
    let
        val size = string.length (text)
        val parsed = parse_value (text, 0, size)
    in
        case parsed of
            Error message => Error (message)
          | Ok (value, next) =>
              let
                  val after = skip_space (text, next, size)
              in
                  if after = size then
                      Ok (value)
                  else
                      Error ("trailing characters at " ^ int_to_string (after))
              end
    end

(* Convertit un chiffre de 0 à 15 en code ASCII hexadécimal minuscule.
   - `value` : valeur du chiffre à encoder.

   Retourne le code ASCII correspondant ; l'appelant fournit une valeur valide. *)
fun hex_digit_code (value : int) : int = if value < 10 then 48 + value else 87 + value

(* Indique si un octet doit être échappé dans une chaîne JSON.
   - `code` : code de l'octet examiné.

   Retourne vrai pour le guillemet, la barre inverse et les contrôles. *)
fun internal_escape_needs (code : int) : bool =
    if code = 34 then
        true
    else if code = 92 then
        true
    else
        code < 32

(* Rend l'échappement JSON d'un octet qui en a besoin.
   - `code` : code de l'octet.

   Retourne la séquence `\"`, `\\`, `\n`, … ou `\u00XX`. *)
fun internal_escape_code (code : int) : string =
    if code = 34 then
        "\\\""
    else if code = 92 then
        "\\\\"
    else if code = 10 then
        "\\n"
    else if code = 13 then
        "\\r"
    else if code = 9 then
        "\\t"
    else if code = 8 then
        "\\b"
    else if code = 12 then
        "\\f"
    else if code < 32 then
        "\\u00" ^ string_of_char (hex_digit_code (code / 16)) ^
            string_of_char (hex_digit_code (code % 16))
    else
        string_of_char (code)

(* Cherche la fin d'une plage d'octets sans échappement.
   - `text` : chaîne source empruntée, non modifiée.
   - `index` : début de la plage.
   - `size` : limite exclusive de lecture.

   Retourne l'index du premier octet à échapper, ou `size`. *)
fun internal_escape_run_end (text : borrow string, index : int, size : int) : int =
    if index >= size then
        index
    else if internal_escape_needs (string.char_at_unchecked (text, index)) then
        index
    else
        internal_escape_run_end (text, index + 1, size)

(* Accumule les morceaux échappés d'une chaîne, en ordre inverse.
   - `text` : chaîne source empruntée, non modifiée.
   - `index` : position du prochain octet.
   - `size` : limite exclusive de lecture.
   - `acc` : morceaux déjà traités, en ordre inverse.

   Retourne les morceaux du contenu échappé ; les plages sans échappement
   sont copiées d'un seul coup, donc le coût est linéaire. *)
fun internal_escape_chunks (
    text : borrow string,
    index : int,
    size : int,
    acc : string list
) : string list =
    if index >= size then
        acc
    else
        let val code = string.char_at_unchecked (text, index)
        in
            if internal_escape_needs (code) then
                internal_escape_chunks (
                    text,
                    index + 1,
                    size,
                    Cons ((internal_escape_code (code), acc))
                )
            else
                let val stop = internal_escape_run_end (text, index, size)
                in
                    internal_escape_chunks (
                        text,
                        stop,
                        size,
                        Cons ((string.slice (text, index, stop), acc))
                    )
                end
        end

(* Échappe le contenu d'une chaîne JSON sans ajouter de guillemets.
   - `text` : chaîne source empruntée, non modifiée.

   Retourne une nouvelle chaîne prête à être incluse dans un littéral JSON. *)
fun escape (text : borrow string) : string =
    internal_concat (
        list.reverse (
            internal_escape_chunks (text, 0, string.length (text), Nil)
        )
    )

(* Passe de fusion de deux morceaux adjacents.
   - `chunks` : morceaux restants, consommés.
   - `acc` : morceaux fusionnés en ordre inverse.

   Retourne la liste fusionnée dans l'ordre, de moitié de longueur. *)
fun internal_merge_chunks (chunks : string list, acc : string list) : string list =
    case chunks of
        Nil => list.reverse (acc)
      | Cons (only, Nil) => list.reverse (Cons ((only, acc)))
      | Cons (left, Cons (right, rest)) =>
            internal_merge_chunks (rest, Cons ((left ^ right, acc)))

(* Concatène des morceaux par fusions équilibrées.
   - `chunks` : morceaux consommés dans l'ordre.

   Retourne leur concaténation. Chaque passe copie tous les octets une fois,
   donc le coût total est `O(n log n)` au lieu du `O(n²)` d'un `acc ^ next`
   répété. *)
fun internal_concat (chunks : string list) : string =
    case chunks of
        Nil => ""
      | Cons (only, Nil) => only
      | Cons (first, Cons (second, rest)) =>
            internal_concat (
                internal_merge_chunks (Cons ((first, Cons ((second, rest)))), Nil)
            )

(* Rend les morceaux d'une valeur, dans l'ordre source.
   - `value` : arbre JSON consommé par inspection.

   Retourne les morceaux à concaténer ; un scalaire en produit un seul. *)
fun internal_chunks_value (value : value) : string list =
    case value of
        Null => Cons (("null", Nil))
      | Bool inner =>
            if inner then Cons (("true", Nil)) else Cons (("false", Nil))
      | Number literal => Cons ((literal, Nil))
      | String text => Cons (("\"" ^ escape (borrow text) ^ "\"", Nil))
      | Array values => internal_chunks_array (values, Cons (("]", Nil)))
      | Object fields => internal_chunks_object (fields, Cons (("}", Nil)))

(* Rend les morceaux d'un tableau, du dernier élément vers le premier.
   - `values` : éléments en ordre inverse, consommés.
   - `acc` : suffixe déjà rendu, dont le `]` final.
   - `needComma` : vrai si un séparateur précède l'élément courant.

   Retourne les morceaux du tableau complet, dans l'ordre source. *)
fun internal_chunks_array_from (
    values : value list,
    acc : string list,
    needComma : bool
) : string list =
    case values of
        Nil => Cons (("[", acc))
      | Cons (value, rest) =>
            let val separator = if needComma then Cons ((",", acc)) else acc
                val next = list.append (internal_chunks_value (value), separator)
            in internal_chunks_array_from (rest, next, true)
            end

(* Rend les morceaux d'un tableau JSON.
   - `values` : éléments en ordre source, consommés.
   - `acc` : suffixe déjà rendu, dont le `]` final.

   Retourne `[...]` en morceaux. *)
fun internal_chunks_array (values : value list, acc : string list) : string list =
    internal_chunks_array_from (list.reverse (values), acc, false)

(* Rend les morceaux d'un champ d'objet, clé et valeur comprises.
   - `name` : clé consommée.
   - `value` : valeur consommée.

   Retourne `"clé":valeur` en morceaux. *)
fun internal_chunks_field (name : string, value : value) : string list =
    list.append (
        Cons (("\"" ^ escape (borrow name) ^ "\":", Nil)),
        internal_chunks_value (value)
    )

(* Rend les morceaux d'un objet, du dernier champ vers le premier.
   - `fields` : champs en ordre inverse, consommés.
   - `acc` : suffixe déjà rendu, dont le `}` final.
   - `needComma` : vrai si un séparateur précède le champ courant.

   Retourne les morceaux de l'objet complet, dans l'ordre source. *)
fun internal_chunks_object_from (
    fields : (string, value) list,
    acc : string list,
    needComma : bool
) : string list =
    case fields of
        Nil => Cons (("{", acc))
      | Cons ((name, value), rest) =>
            let val separator = if needComma then Cons ((",", acc)) else acc
                val next = list.append (internal_chunks_field (name, value), separator)
            in internal_chunks_object_from (rest, next, true)
            end

(* Rend les morceaux d'un objet JSON.
   - `fields` : champs en ordre source, consommés.
   - `acc` : suffixe déjà rendu, dont le `}` final.

   Retourne `{...}` en morceaux. *)
fun internal_chunks_object (
    fields : (string, value) list,
    acc : string list
) : string list =
    internal_chunks_object_from (list.reverse (fields), acc, false)

(* Sérialise une valeur en texte JSON, en conservant l'ordre des listes.
   - `value` : arbre JSON consommé par inspection, sans mutation en place.

   Retourne le document JSON correspondant. Le rendu passe par des morceaux
   puis une concaténation équilibrée, donc un grand document reste linéaire
   en temps comme en mémoire. *)
fun to_string (value : value) : string =
    internal_concat (internal_chunks_value (value))

(* Donne le nom JSON d'un constructeur, pour les messages d'erreur.
   - `value` : valeur inspectée et consommée.

   Retourne `null`, `bool`, `number`, `string`, `array` ou `object`. *)
fun internal_value_kind (value : value) : string =
    case value of
        Null => "null"
      | Bool _ => "bool"
      | Number _ => "number"
      | String _ => "string"
      | Array _ => "array"
      | Object _ => "object"

(* Formate une erreur de type sans chemin : `expected X, found Y`.
   - `expected` : type attendu, emprunté puis copié.
   - `value` : valeur réellement reçue, consommée.

   Retourne le message employé par les `as_*` et préfixé par les `take_*`. *)
fun internal_type_error (expected : &string, value : value) : string =
    "expected " ^ string.copy (expected) ^ ", found " ^ internal_value_kind (value)

(* Reconnaît un chiffre décimal ASCII.
   - `code` : code du caractère examiné.

   Retourne vrai pour `0` à `9`, sinon faux. *)
fun internal_is_digit (code : int) : bool =
    if code >= 48 then code <= 57 else false

(* Avance sur un groupe de chiffres décimaux.
   - `text` : littéral emprunté, non modifié.
   - `index` : position courante.
   - `size` : limite exclusive.

   Retourne l'index du premier caractère qui n'est pas un chiffre. *)
fun internal_digits_end (text : &string, index : int, size : int) : int =
    if index >= size then
        index
    else if internal_is_digit (string.char_at_unchecked (text, index)) then
        internal_digits_end (text, index + 1, size)
    else
        index

(* Analyse la fraction et l'exposant d'un nombre JSON.
   - `text` : littéral emprunté, non modifié.
   - `index` : position après la partie entière.
   - `size` : limite exclusive.

   Retourne l'index de fin, ou `None` si la fraction ou l'exposant est
   vide/incomplet. *)
fun internal_number_fraction (text : &string, index : int, size : int) : int option =
    if index < size then
        if string.char_at_unchecked (text, index) = 46 then
            let val digits = internal_digits_end (text, index + 1, size)
            in
                if digits = index + 1 then
                    None
                else
                    internal_number_exponent (text, digits, size)
            end
        else
            internal_number_exponent (text, index, size)
    else
        Some (index)

(* Analyse l'exposant optionnel d'un nombre JSON.
   - `text` : littéral emprunté, non modifié.
   - `index` : position après la mantisse.
   - `size` : limite exclusive.

   Retourne l'index de fin, ou `None` si `e`/`E` n'est pas suivi de
   chiffres. *)
fun internal_number_exponent (text : &string, index : int, size : int) : int option =
    if index < size then
        let val code = string.char_at_unchecked (text, index)
        in
            if code = 101 then
                internal_number_exponent_digits (text, index + 1, size)
            else if code = 69 then
                internal_number_exponent_digits (text, index + 1, size)
            else
                Some (index)
        end
    else
        Some (index)

(* Lit les chiffres d'un exposant, après un signe optionnel.
   - `text` : littéral emprunté, non modifié.
   - `index` : position après `e`/`E`.
   - `size` : limite exclusive.

   Retourne l'index de fin, ou `None` si aucun chiffre ne suit. *)
fun internal_number_exponent_digits (text : &string, index : int, size : int) : int option =
    if index < size then
        let val code = string.char_at_unchecked (text, index)
        in
            if code = 43 then
                internal_number_exponent_value (text, index + 1, size)
            else if code = 45 then
                internal_number_exponent_value (text, index + 1, size)
            else
                internal_number_exponent_value (text, index, size)
        end
    else
        None

(* Vérifie qu'un exposant contient au moins un chiffre.
   - `text` : littéral emprunté, non modifié.
   - `index` : position du premier chiffre possible.
   - `size` : limite exclusive.

   Retourne l'index de fin, ou `None` si le groupe est vide. *)
fun internal_number_exponent_value (text : &string, index : int, size : int) : int option =
    let val digits = internal_digits_end (text, index, size)
    in
        if digits = index then None else Some (digits)
    end

(* Analyse la partie entière et la suite d'un nombre JSON.
   - `text` : littéral emprunté, non modifié.
   - `index` : position après le signe optionnel.
   - `size` : limite exclusive.

   Refuse le zéro de tête (`01`) comme la grammaire JSON. Retourne l'index
   de fin, ou `None`. *)
fun internal_number_integer (text : &string, index : int, size : int) : int option =
    if index >= size then
        None
    else
        let val code = string.char_at_unchecked (text, index)
        in
            if code = 48 then
                internal_number_fraction (text, index + 1, size)
            else if internal_is_digit (code) then
                let val digits = internal_digits_end (text, index, size)
                in internal_number_fraction (text, digits, size) end
            else
                None
        end

(* Vérifie qu'un littéral est un nombre JSON complet.
   - `text` : littéral emprunté, non modifié.
   - `index` : position de départ.
   - `size` : limite exclusive.

   Retourne `Some` index de fin si le littéral est un nombre JSON valide,
   `None` sinon. *)
fun internal_number_end (text : &string, index : int, size : int) : int option =
    if index >= size then
        None
    else if string.char_at_unchecked (text, index) = 45 then
        internal_number_integer (text, index + 1, size)
    else
        internal_number_integer (text, index, size)

(* Vérifie que la valeur JSON est nulle.
   - `value` : valeur inspectée et consommée par correspondance de motif.

   Retourne `Ok ()` pour `Null`, sinon `expected null, found …`. *)
fun as_null (value : value) : unit result =
    case value of
        Null => Ok (())
      | other => Error (internal_type_error (&"null", other))

(* Extrait un booléen d'une valeur JSON.
   - `value` : valeur inspectée et consommée.

   Retourne le booléen si le constructeur est `Bool`, sinon
   `expected bool, found …`. *)
fun as_bool (value : value) : bool result =
    case value of
        Bool inner => Ok (inner)
      | other => Error (internal_type_error (&"bool", other))

(* Extrait une chaîne d'une valeur JSON.
   - `value` : valeur inspectée et consommée.

   Retourne la chaîne si le constructeur est `String`, sinon
   `expected string, found …`. *)
fun as_string (value : value) : string result =
    case value of
        String inner => Ok (inner)
      | other => Error (internal_type_error (&"string", other))

(* Convertit un nombre JSON entier en valeur Yack `int`.
   - `value` : valeur inspectée et consommée.

   Retourne l'entier si son texte est accepté par `string_to_int`, sinon
   `expected int, found number \`lexème\`` ; une valeur d'un autre
   constructeur donne `expected int, found <type>`. Une valeur hors de la
   plage 32 bits donne donc `Error`, sans débordement silencieux. *)
fun as_int (value : value) : int result =
    case value of
        Number literal =>
            (case string_to_int (borrow literal) of
                 None =>
                     Error ("expected int, found number `" ^ literal ^ "`")
               | Some inner => Ok (inner))
      | other => Error (internal_type_error (&"int", other))

(* Vérifie qu'un littéral suit exactement la grammaire JSON des nombres.
   - `literal` : texte emprunté, non modifié.

   Retourne vrai si tout le texte est un nombre JSON : signe optionnel,
   partie entière sans zéro de tête, fraction et exposant optionnels. *)
fun internal_is_number_literal (literal : &string) : bool =
    let
        val size = string.length (literal)
        val stop = internal_number_end (literal, 0, size)
    in
        case stop of
            Some (stop) => stop = size
          | None => false
    end

(* Extrait un flottant d'une valeur JSON.
   - `value` : valeur inspectée et consommée.

   Accepte un entier JSON (`1`) comme un littéral flottant (`1.5`,
   `-0.25e3`), après la vérification stricte de la grammaire JSON des
   nombres. La conversion passe par `string_to_float` (`strtod`), donc elle
   est arrondie correctement : un texte hors grammaire, `inf` ou `nan` donne
   `Error`, et un débordement (`1e999`) aussi au lieu d'un infini. Un
   sous-flux (`1e-999`) donne `0.0`. *)
fun as_float (value : value) : float result =
    case value of
        Number literal =>
            if internal_is_number_literal (&literal) then
                (case string_to_float (borrow literal) of
                     None =>
                         Error ("expected float, found number `" ^ literal ^ "`")
                   | Some (parsed) => Ok (parsed))
            else
                Error ("expected float, found number `" ^ literal ^ "`")
      | other => Error (internal_type_error (&"float", other))

(* Extrait la liste des éléments d'un tableau JSON.
   - `value` : valeur inspectée et consommée.

   Retourne la liste si le constructeur est `Array`, sinon
   `expected array, found …`. *)
fun as_array (value : value) : value list result =
    case value of
        Array inner => Ok (inner)
      | other => Error (internal_type_error (&"array", other))

(* Extrait les couples clé-valeur d'un objet JSON.
   - `value` : valeur inspectée et consommée.

   Retourne la liste si le constructeur est `Object`, sinon
   `expected object, found …`. *)
fun as_object (value : value) : (string, value) list result =
    case value of
        Object inner => Ok (inner)
      | other => Error (internal_type_error (&"object", other))

(* Consomme une valeur JSON sans la rendre.
   - `value` : valeur abandonnée. *)
fun discard_value (value : value) : unit = ()

(* Consomme les champs restants d'un objet.
   - `fields` : champs abandonnés. *)
fun discard_fields (fields : (string, value) list) : unit =
    case fields of
        Nil => ()
      | Cons (_, rest) => discard_fields (rest)

(* Formate l'erreur d'un champ obligatoire absent.
   - `name` : clé cherchée, empruntée puis copiée dans le message.

   Retourne ``missing field `name` ``. *)
fun internal_missing_field (name : &string) : string =
    "missing field `" ^ string.copy (name) ^ "`"

(* Préfixe une erreur par le chemin d'un champ d'objet.
   - `key` : clé du champ, consommée.
   - `message` : erreur interne, consommée.

   Un message déjà indexé (`[0]: …`) est collé tel quel, une erreur brute
   (`expected …` ou `missing field …`) reçoit `key: `, et un chemin
   imbriqué (`zip: …`) reçoit `key.`. *)
fun internal_prefix_field (key : string, message : string) : string =
    if string.starts_with (&message, &"expected ") then
        key ^ ": " ^ message
    else if string.starts_with (&message, &"missing field") then
        key ^ ": " ^ message
    else if string.starts_with (&message, &"[") then
        key ^ message
    else
        key ^ "." ^ message

(* Préfixe une erreur par un index de liste.
   - `prefix` : chemin de la liste, emprunté (`""` à la racine).
   - `index` : indice de l'élément fautif.
   - `message` : erreur interne, consommée.

   Produit `prefix[i]: expected …` pour une erreur brute,
   `prefix[i].name: …` pour un chemin de champ, et `prefix[i][j]: …` pour
   une liste imbriquée. *)
fun internal_prefix_index (prefix : &string, index : int, message : string) : string =
    let val label = string.copy (prefix) ^ "[" ^ int_to_string (index) ^ "]"
    in
        if string.starts_with (&message, &"expected ") then
            label ^ ": " ^ message
        else if string.starts_with (&message, &"missing field") then
            label ^ ": " ^ message
        else if string.starts_with (&message, &"[") then
            label ^ message
        else
            label ^ "." ^ message
    end

(* Parcours de `take` avec un accumulateur inversé.
   - `name` : clé cherchée, empruntée.
   - `fields` : champs restants, consommés.
   - `acc` : champs déjà sautés, en ordre inverse.

   Retourne la valeur du premier champ correspondant et le reste de
   l'objet, dans l'ordre source. *)
fun take_from (
    name : &string,
    fields : (string, value) list,
    acc : (string, value) list
) : (value option * (string, value) list) =
    case fields of
        Nil => (None, list.reverse (acc))
      | Cons ((key, value), rest) =>
            if string.equals (name, &key) then
                let val ignored = list.discard_value (key)
                in (Some (value), list.reverse_into (acc, rest))
                end
            else
                take_from (name, rest, Cons (((key, value), acc)))

(* Retire le premier champ portant une clé et rend le reste de l'objet.
   - `name` : clé cherchée, empruntée sans modification.
   - `fields` : couples de l'objet, consommés par le parcours.

   Retourne `Some valeur` si la clé est présente (le premier doublon
   gagne), sinon `None`, avec le reste des champs dans l'ordre source. Les
   entrées sautées et les doublons restent dans le reste, à libérer par
   `discard_fields` quand ils ne servent plus. *)
fun take (name : &string, fields : (string, value) list) : (value option * (string, value) list) =
    take_from (name, fields, Nil)

(* Retire un champ entier obligatoire.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne l'entier et le reste de l'objet. Un champ absent donne
   ``missing field `name` `` ; un autre type donne
   `name: expected int, found string`. Le reste est libéré en cas
   d'erreur. *)
fun take_int (name : &string, fields : (string, value) list) : (int * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case as_int (value) of
                Ok (inner) => Ok ((inner, rest))
              | Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end

(* Retire un champ flottant obligatoire.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Accepte aussi un entier JSON. Retourne le flottant et le reste de
   l'objet, ou une erreur préfixée par `name`. *)
fun take_float (name : &string, fields : (string, value) list) : (float * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case as_float (value) of
                Ok (inner) => Ok ((inner, rest))
              | Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end

(* Retire un champ booléen obligatoire.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne le booléen et le reste de l'objet, ou une erreur préfixée par
   `name`. *)
fun take_bool (name : &string, fields : (string, value) list) : (bool * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case as_bool (value) of
                Ok (inner) => Ok ((inner, rest))
              | Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end

(* Retire un champ chaîne obligatoire.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne la chaîne et le reste de l'objet, ou une erreur préfixée par
   `name`. *)
fun take_string (name : &string, fields : (string, value) list) : (string * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case as_string (value) of
                Ok (inner) => Ok ((inner, rest))
              | Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end

(* Retire un champ optionnel.
   - `decoder` : décodeur de la valeur présente, qui la consomme.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne `None` et le reste si le champ est absent, `None` si sa valeur
   est `null`, sinon `Some` du résultat de `decoder`. Une erreur du
   décodeur est préfixée par `name`. *)
fun take_option (
    decoder : !value -> 'a result,
    name : &string,
    fields : (string, value) list
) : ('a option * (string, value) list) result =
    case take (name, fields) of
        (None, rest) => Ok ((None, rest))
      | (Some (value), rest) =>
            case value of
                Null => Ok ((None, rest))
              | present =>
                    case decoder (present) of
                        Ok (inner) => Ok ((Some (inner), rest))
                      | Error (message) =>
                            let val ignored = discard_fields (rest)
                            in Error (internal_prefix_field (string.copy (name), message))
                            end

(* Retire un champ et le décode avec une fonction, en préfixant les
   erreurs du chemin.
   - `decoder` : décodeur appliqué à la valeur, qui la consomme.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Sert aux objets imbriqués : une erreur `zip: …` devient
   `address.zip: …`. Retourne la valeur décodée et le reste de l'objet. *)
fun take_object (
    decoder : !value -> 'a result,
    name : &string,
    fields : (string, value) list
) : ('a * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case decoder (value) of
                Ok (inner) => Ok ((inner, rest))
              | Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end

(* Décode les éléments d'un tableau avec un chemin de liste.
   - `decoder` : décodeur d'un élément, qui le consomme.
   - `prefix` : chemin de la liste, emprunté (`""` à la racine).
   - `values` : éléments restants, consommés.
   - `index` : indice de l'élément courant.
   - `acc` : résultats en ordre inverse.

   Retourne les valeurs décodées, ou la première erreur préfixée par
   `<prefix>[i]`. Le suffixe et l'accumulateur sont libérés en cas
   d'erreur. *)
fun internal_decode_list (
    decoder : !value -> 'a result,
    prefix : &string,
    values : value list,
    index : int,
    acc : 'a list
) : 'a list result =
    case values of
        Nil => Ok (list.reverse (acc))
      | Cons (value, rest) =>
            case decoder (value) of
                Ok (decoded) =>
                    internal_decode_list (decoder, prefix, rest, index + 1, Cons ((decoded, acc)))
              | Error (message) =>
                    let val ignoredRest = list.discard_list (rest)
                        val ignoredAcc = list.discard_list (acc)
                    in Error (internal_prefix_index (prefix, index, message))
                    end

(* Retire un champ tableau et décode ses éléments.
   - `decoder` : décodeur d'un élément, qui le consomme.
   - `name` : clé attendue, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne la liste décodée et le reste de l'objet. Une erreur d'élément
   donne `items[2]: …` ou `items[2].name: …`. *)
fun take_list (
    decoder : !value -> 'a result,
    name : &string,
    fields : (string, value) list
) : ('a list * (string, value) list) result =
    case take (name, fields) of
        (None, rest) =>
            let val ignored = discard_fields (rest)
            in Error (internal_missing_field (name))
            end
      | (Some (value), rest) =>
            case as_array (value) of
                Error (message) =>
                    let val ignored = discard_fields (rest)
                    in Error (internal_prefix_field (string.copy (name), message))
                    end
              | Ok (values) =>
                    case internal_decode_list (decoder, name, values, 0, Nil) of
                        Ok (decoded) => Ok ((decoded, rest))
                      | Error (message) =>
                            let val ignored = discard_fields (rest)
                            in Error (message)
                            end

(* Recherche la première entrée portant une clé donnée.
   - `name` : clé cherchée, empruntée sans modification.
   - `fields` : couples parcourus dans l'ordre et consommés par la recherche.

   Retourne la valeur du premier doublon correspondant, ou `None`. *)
fun find_field (name : borrow string, fields : (string, value) list) : value option =
    case fields of
        Nil => None
      | Cons ((key, value), rest) =>
          if string.equals (name, borrow key) then
              let val ignored = discard_fields (rest) in Some (value) end
          else
              let val ignored = discard_value (value)
              in find_field (name, rest)
              end

(* Recherche optionnellement un champ d'objet par sa clé.
   - `name` : clé recherchée, empruntée.
   - `fields` : liste des couples consommée par le parcours.

   Retourne la première valeur correspondante, ou `None`. *)
fun field (name : borrow string, fields : (string, value) list) : value option =
    find_field (name, fields)

(* Recherche un champ obligatoire dans une liste de champs.
   - `name` : clé attendue, empruntée (copiée uniquement pour l'erreur).
   - `fields` : couples parcourus et consommés par la recherche.

   Retourne la première valeur correspondante, ou une erreur nommant la clé. *)
fun required (name : borrow string, fields : (string, value) list) : value result =
    case find_field (name, fields) of
        None => Error ("missing field `" ^ string.copy (name) ^ "`")
      | Some value => Ok (value)

(* Recherche un champ obligatoire et le convertit en entier.
   - `name` : clé cherchée, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne l'entier ou l'erreur de champ manquant/de conversion. *)
fun field_int (name : borrow string, fields : (string, value) list) : int result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value =>
          case as_int (value) of
              Error message => Error (message)
            | Ok inner => Ok (inner)

(* Recherche un champ obligatoire et l'extrait comme chaîne.
   - `name` : clé cherchée, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne la chaîne ou l'erreur de champ manquant/de type. *)
fun field_string (name : borrow string, fields : (string, value) list) : string result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value =>
          case as_string (value) of
              Error message => Error (message)
            | Ok inner => Ok (inner)

(* Recherche un champ obligatoire et l'extrait comme booléen.
   - `name` : clé cherchée, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne le booléen ou l'erreur de champ manquant/de type. *)
fun field_bool (name : borrow string, fields : (string, value) list) : bool result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value =>
          case as_bool (value) of
              Error message => Error (message)
            | Ok inner => Ok (inner)

(* Recherche un champ obligatoire et l'extrait comme tableau.
   - `name` : clé cherchée, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne les éléments ou l'erreur de champ manquant/de type. *)
fun field_array (name : borrow string, fields : (string, value) list) : value list result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value =>
          case as_array (value) of
              Error message => Error (message)
            | Ok inner => Ok (inner)

(* Recherche un champ obligatoire et l'extrait comme objet.
   - `name` : clé cherchée, empruntée.
   - `fields` : couples de l'objet, consommés par la recherche.

   Retourne les couples ou l'erreur de champ manquant/de type. *)
fun field_object (name : borrow string, fields : (string, value) list) : (string, value) list result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value =>
          case as_object (value) of
              Error message => Error (message)
            | Ok inner => Ok (inner)

(* Applique `f` à chaque valeur d'un tableau JSON.
   - `f` : fonction appliquée à chaque valeur.
   - `values` : éléments du tableau, consommés. *)
fun array_map (f : consume value -> 'a, values : value list) : 'a list =
    case values of
        Nil => Nil
      | Cons (value, rest) =>
            Cons ((f (value), array_map (f, rest)))

(* Parcours de `array_filter_map` avec un accumulateur inversé.
   - `f` : fonction appliquée à chaque valeur.
   - `values` : éléments du tableau, consommés.
   - `acc` : résultats retenus, dans l’ordre inverse. *)
fun array_filter_map_from
        (f : consume value -> 'a option, values : value list, acc : 'a list)
        : 'a list =
    case values of
        Nil => list.reverse (acc)
      | Cons (value, rest) =>
            case f (value) of
                None => array_filter_map_from (f, rest, acc)
              | Some (mapped) =>
                    array_filter_map_from (f, rest, Cons ((mapped, acc)))

(* Applique `f` et ne garde que les `Some`, dans l’ordre.
   - `f` : fonction appliquée à chaque valeur.
   - `values` : éléments du tableau, consommés. *)
fun array_filter_map (f : consume value -> 'a option, values : value list) : 'a list =
    array_filter_map_from (f, values, Nil)

(* Plie les valeurs d'un tableau de la gauche vers la droite.
   - `f` : fonction `(accumulateur, valeur) -> accumulateur`.
   - `init` : accumulateur initial.
   - `values` : éléments du tableau, consommés. *)
fun array_foldl (f : consume ('acc * value) -> 'acc, init : 'acc, values : value list) : 'acc =
    case values of
        Nil => init
      | Cons (value, rest) =>
            let val next = f ((init, value))
            in array_foldl (f, next, rest)
            end

(* Décode toutes les valeurs d'un tableau, en s'arrêtant à la première erreur.
   - `decoder` : décodeur appliqué à chaque valeur.
   - `values` : éléments du tableau, consommés. *)
fun array_decode (decoder : consume value -> 'a result, values : value list) : 'a list result =
    case values of
        Nil => Ok (Nil)
      | Cons (value, rest) =>
            case decoder (value) of
                Error message => Error (message)
              | Ok decoded =>
                  case array_decode (decoder, rest) of
                      Error message => Error (message)
                    | Ok decodedRest => Ok (Cons ((decoded, decodedRest)))

(* Applique `f` à chaque couple clé-valeur d'un objet.
   - `f` : fonction appliquée à chaque couple.
   - `fields` : champs de l'objet, consommés. *)
fun object_map (f : consume (string * value) -> 'a, fields : (string, value) list) : 'a list =
    case fields of
        Nil => Nil
      | Cons (field, rest) =>
            Cons ((f (field), object_map (f, rest)))

(* Transforme les valeurs d'un objet en conservant les clés.
   - `f` : fonction appliquée à chaque valeur.
   - `fields` : champs de l'objet, consommés. *)
fun object_map_values (f : consume value -> 'a, fields : (string, value) list) : (string, 'a) list =
    case fields of
        Nil => Nil
      | Cons ((key, value), rest) =>
            Cons (((key, f (value)), object_map_values (f, rest)))

(* Décode les valeurs d'un objet en conservant les clés.
   - `decoder` : décodeur appliqué à chaque valeur.
   - `fields` : champs de l'objet, consommés. *)
fun object_decode_values (decoder : consume value -> 'a result, fields : (string, value) list) : (string, 'a) list result =
    case fields of
        Nil => Ok (Nil)
      | Cons ((key, value), rest) =>
            case decoder (value) of
                Error message => Error (message)
              | Ok decoded =>
                  case object_decode_values (decoder, rest) of
                      Error message => Error (message)
                    | Ok decodedRest => Ok (Cons (((key, decoded), decodedRest)))

(* Recherche un champ et applique un décodeur à sa valeur.
   - `name` : clé cherchée, empruntée.
   - `decoder` : décodeur appliqué à la valeur trouvée.
   - `fields` : champs de l'objet, consommés. *)
fun field_decode (name : borrow string, decoder : consume value -> 'a result, fields : (string, value) list) : 'a result =
    case required (name, fields) of
        Error message => Error (message)
      | Ok value => decoder (value)

(* Décode les éléments d'un tableau JSON.
   - `decoder` : décodeur d'un élément, qui le consomme.
   - `value` : valeur inspectée et consommée.

   Retourne la liste décodée, ou `expected array, found …` et
   `[i]: …` / `[i].name: …` pour un élément fautif. Le suffixe est libéré
   dès la première erreur. *)
fun decode_list (decoder : !value -> 'a result, value : value) : 'a list result =
    case as_array (value) of
        Error (message) => Error (message)
      | Ok (values) => internal_decode_list (decoder, &"", values, 0, Nil)

(* Décode un `option` JSON : `null` devient `None`.
   - `decoder` : décodeur de la valeur présente, qui la consomme.
   - `value` : valeur inspectée et consommée.

   Retourne `Ok (None)` pour `Null`, sinon `Some` du résultat de
   `decoder`, ou son erreur. *)
fun decode_option (decoder : !value -> 'a result, value : value) : 'a option result =
    case value of
        Null => Ok (None)
      | present =>
            case decoder (present) of
                Ok (inner) => Ok (Some (inner))
              | Error (message) => Error (message)

(* Analyse un document puis applique un décodeur.
   - `text` : document emprunté et non modifié.
   - `decoder` : décodeur appliqué à la racine, qui la consomme.

   Retourne le résultat du décodeur, ou l'erreur de syntaxe de `parse`. *)
fun decode (text : &string, decoder : !value -> 'a result) : 'a result =
    case parse (text) of
        Error (message) => Error (message)
      | Ok (value) => decoder (value)
