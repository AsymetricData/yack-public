(* Retourne la valeur absolue d'un entier.
   - `value` : entier dont on veut la valeur absolue.

   Retourne `value` s'il est positif ou nul, sinon son opposé. Aucun effet mémoire. *)
fun abs_int (value : int) : int = if value < 0 then 0 - value else value

(* Retourne le plus petit de deux entiers.
   - `left` : premier entier à comparer.
   - `right` : second entier à comparer.

   Retourne l'entier inférieur ou, en cas d'égalité, leur valeur commune. Aucun effet
   mémoire. *)
fun min_int (left : int, right : int) : int = if left <= right then left else right

(* Retourne le plus grand de deux entiers.
   - `left` : premier entier à comparer.
   - `right` : second entier à comparer.

   Retourne l'entier supérieur ou, en cas d'égalité, leur valeur commune. Aucun effet
   mémoire. *)
fun max_int (left : int, right : int) : int = if left >= right then left else right

(* Borne un entier dans l'intervalle défini par ses deux limites.
   - `value` : valeur à borner.
   - `low` : limite inférieure.
   - `high` : limite supérieure.

   Retourne `low` si `value` lui est inférieur, `high` s'il lui est supérieur, sinon
   `value`. Aucun effet mémoire. *)
fun clamp_int (value : int, low : int, high : int) : int =
    if value < low then low else if value > high then high else value

(* Indique le signe d'un entier par une valeur de -1, 0 ou 1.
   - `value` : entier dont on veut déterminer le signe.

   Retourne -1 pour un entier négatif, 1 pour un entier positif et 0 pour zéro. Aucun
   effet mémoire. *)
fun sign_int (value : int) : int = if value < 0 then -1 else if value > 0 then 1 else 0

(* Vérifie si un entier est divisible par deux.
   - `value` : entier à tester.

   Retourne `true` si `value` est pair, sinon `false`. Aucun effet mémoire. *)
fun is_even (value : int) : bool = value % 2 = 0

(* Vérifie si un entier n'est pas divisible par deux.
   - `value` : entier à tester.

   Retourne `true` si `value` est impair, sinon `false`. Aucun effet mémoire. *)
fun is_odd (value : int) : bool = value % 2 <> 0

(* Calcule récursivement le plus grand commun diviseur avec l'algorithme d'Euclide.
   - `a` : premier opérande courant.
   - `b` : second opérande courant, dont le reste sert à poursuivre le calcul.

   Retourne `a` lorsque `b` vaut zéro. Fonction récursive sans effet mémoire. *)
fun gcd_from (a : int, b : int) : int = if b = 0 then a else gcd_from (b, a % b)

(* Calcule le plus grand commun diviseur positif de deux entiers.
   - `left` : premier entier.
   - `right` : second entier.

   Retourne le PGCD des valeurs absolues des opérandes. Aucun effet mémoire. *)
fun gcd (left : int, right : int) : int = gcd_from (abs_int (left), abs_int (right))

(* Calcule le plus petit multiple commun de deux entiers.
   - `left` : premier entier.
   - `right` : second entier.

   Retourne zéro si l'un des opérandes vaut zéro, sinon le PPCM positif. Aucun effet
   mémoire. *)
fun lcm (left : int, right : int) : int =
    if left = 0 then
        0
    else if right = 0 then 0 else abs_int (left / gcd (left, right) * right)

(* Calcule une puissance entière positive par multiplications successives.
   - `base` : base à multiplier.
   - `exponent` : nombre de multiplications restantes ; une valeur inférieure ou
     égale à zéro termine le calcul.
   - `acc` : accumulateur initial du résultat.

   Retourne l'accumulateur multiplié par `base` `exponent` fois au plus. Fonction
   récursive sans effet mémoire. *)
fun pow_int_from (base : int, exponent : int, acc : int) : int =
    if exponent <= 0 then acc else pow_int_from (base, exponent - 1, acc * base)

(* Calcule une puissance entière pour un exposant non négatif.
   - `base` : base de la puissance.
   - `exponent` : exposant ; s'il est négatif, le résultat est défini ici comme zéro.

   Retourne `base` élevé à `exponent`, avec 1 pour l'exposant zéro. Aucun effet
   mémoire. *)
fun pow_int (base : int, exponent : int) : int =
    if exponent < 0 then 0 else pow_int_from (base, exponent, 1)

(* Retourne la valeur absolue d'un flottant.
   - `value` : flottant dont on veut la valeur absolue.

   Retourne `value` s'il est positif ou nul, sinon son opposé. Aucun effet mémoire. *)
fun abs_float (value : float) : float = if value < 0.0 then 0.0 - value else value

(* Retourne le plus petit de deux flottants.
   - `left` : premier flottant à comparer.
   - `right` : second flottant à comparer.

   Retourne l'opérande inférieur ou, en cas d'égalité, `left`. Aucun effet mémoire. *)
fun min_float (left : float, right : float) : float =
    if left <= right then left else right

(* Retourne le plus grand de deux flottants.
   - `left` : premier flottant à comparer.
   - `right` : second flottant à comparer.

   Retourne l'opérande supérieur ou, en cas d'égalité, `left`. Aucun effet mémoire. *)
fun max_float (left : float, right : float) : float =
    if left >= right then left else right

(* Borne un flottant dans l'intervalle défini par ses deux limites.
   - `value` : valeur à borner.
   - `low` : limite inférieure.
   - `high` : limite supérieure.

   Retourne `low` si `value` lui est inférieur, `high` s'il lui est supérieur, sinon
   `value`. Aucun effet mémoire. *)
fun clamp_float (value : float, low : float, high : float) : float =
    if value < low then low else if value > high then high else value

(* Raffine une approximation de racine carrée par itérations de Newton.
   - `value` : radicande positif.
   - `guess` : approximation courante.
   - `count` : nombre d'itérations déjà effectuées.

   Retourne l'approximation après au plus 24 itérations. Fonction récursive sans
   effet mémoire. *)
fun sqrt_iter (value : float, guess : float, count : int) : float =
    if count >= 24 then
        guess
    else
        sqrt_iter (value, (guess + value / guess) / 2.0, count + 1)

(* Approxime la racine carrée d'un flottant positif par la méthode de Newton.
   - `value` : radicande à traiter.

   Retourne zéro si `value` est inférieur ou égal à zéro, sinon une approximation
   après au plus 24 étapes. Aucun effet mémoire. *)
fun sqrt (value : float) : float =
    if value <= 0.0 then 0.0 else sqrt_iter (value, value / 2.0, 0)

(* Fournit une approximation flottante de la constante π. Aucun argument. Retourne
   3.141592653589793 ; aucun effet mémoire. *)
fun pi () : float = 3.141592653589793

(* Fournit une approximation flottante de la constante e. Aucun argument. Retourne
   2.718281828459045 ; aucun effet mémoire. *)
fun e () : float = 2.718281828459045
