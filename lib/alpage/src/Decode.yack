import yack/json

fun parse (body : borrow string) : json.value result =
    json.parse (body)

fun int (value : consume json.value) : int result =
    json.as_int (value)

fun string (value : consume json.value) : string result =
    json.as_string (value)

fun bool (value : consume json.value) : bool result =
    json.as_bool (value)

fun int_list (value : consume json.value) : int list result =
    case json.as_array (value) of
        Error message => Error (message)
      | Ok values => json.array_decode (int, values)

fun object (value : consume json.value) : (string, json.value) list result =
    json.as_object (value)

fun field_int (name : borrow string, fields : (string, json.value) list) : int result =
    json.field_int (name, fields)

fun field_string (name : borrow string, fields : (string, json.value) list) : string result =
    json.field_string (name, fields)
