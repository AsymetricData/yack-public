MLTON ?= mlton
MLTONFLAGS ?= -default-ann 'allowExtendedTextConsts true'
WATCH_ENTRY ?= examples/stdlib/src/main.yack

SOURCES := $(wildcard src/*.sml)
BUILD_INFO := src/build_info.sml
GIT_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)

.PHONY: all test test-nll test-alpage test-http-server test-http-limits test-http-fuzz test-borrow test-sqlite-pool test-threads test-lsp test-stdlib-docs test-asan test-stack test-cli test-fuzz test-fuzz-asan test-fuzz-ownership test-regions watch watch-once clean

all: yack

yack: yack.mlb $(SOURCES) $(BUILD_INFO)
	$(MLTON) $(MLTONFLAGS) -output $@ yack.mlb

$(BUILD_INFO): FORCE
	@printf '(* Generated by the Makefile.  Do not edit. *)\nstructure BuildInfo =\nstruct\n  val commit = "%s"\nend\n' '$(GIT_COMMIT)' > $@.tmp
	@cmp -s $@.tmp $@ || mv $@.tmp $@
	@rm -f $@.tmp

.PHONY: FORCE
FORCE:

test: yack
	bash -c 'ulimit -v 2000000; timeout 300 ./test/run.sh'
	node test/lsp.mjs
	node test/lsp_parity.mjs
	node test/stdlib_docs.mjs
	bash -c 'ulimit -v 2000000; timeout 300 ./test/cli.sh'
	bash -c 'ulimit -v 2000000; timeout 60 ./test/threads.sh'
	bash -c 'ulimit -v 2000000; timeout 60 ./test/alpage.sh'
	bash -c 'ulimit -v 2000000; timeout 120 ./test/http_server.sh'
	bash -c 'ulimit -v 2000000; timeout 120 ./test/http_server_limits.sh'
	timeout 180 ./test/borrow.sh
	timeout 300 ./test/nll.sh

test-nll: yack
	timeout 300 ./test/nll.sh

test-alpage: yack
	bash -c 'ulimit -v 2000000; timeout 60 ./test/alpage.sh'

test-http-server: yack
	bash -c 'ulimit -v 2000000; timeout 120 ./test/http_server.sh'

test-http-limits: yack
	bash -c 'ulimit -v 2000000; timeout 120 ./test/http_server_limits.sh'

test-http-fuzz: yack
	bash -c 'timeout 600 ./test/http_fuzz.sh'

test-borrow: yack
	timeout 180 ./test/borrow.sh

test-sqlite-pool: yack
	bash -c 'ulimit -v 2000000; timeout 60 ./test/sqlite_pool_threads.sh'

test-threads: yack
	bash -c 'ulimit -v 2000000; timeout 60 ./test/threads.sh'
	bash test/thread_tsan.sh

test-sql: yack
	bash -c 'ulimit -v 2000000; timeout 60 ./test/sql.sh'

test-lsp: yack
	node test/lsp.mjs
	node test/lsp_parity.mjs

test-stdlib-docs:
	node test/stdlib_docs.mjs

test-cli: yack
	bash -c 'ulimit -v 2000000; timeout 300 ./test/cli.sh'

test-asan: yack
	timeout 300 ./test/asan.sh

.PHONY: test-arena-poison

test-arena-poison: yack
	timeout 600 ./test/arena_poison.sh

test-regions: yack
	timeout 600 ./test/region_scan.sh

test-stack: yack
	bash -c 'ulimit -v 2000000; timeout 300 ./test/stack_mode.sh'

test-fuzz: yack
	bash -c 'ulimit -v 2000000; timeout 600 python3 test/fuzz_tail.py'
	bash test/tail_loop.sh

test-fuzz-asan: yack
	FUZZ_ASAN=1 timeout 900 python3 test/fuzz_tail.py

test-fuzz-ownership: yack
	timeout 7200 python3 test/fuzz_ownership.py "$${FUZZ_COUNT:-300}" --family all

watch: yack
	./tools/yack-watch.ts $(WATCH_ENTRY)

watch-once: yack
	./tools/yack-watch.ts $(WATCH_ENTRY) --once

clean:
	rm -f yack yack-dev
	rm -rf .yack
